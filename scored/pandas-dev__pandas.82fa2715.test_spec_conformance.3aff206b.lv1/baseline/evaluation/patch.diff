+def dtype_to_arrow_c_fmt(dtype: DtypeObj) -> str:
+    """Convert a pandas or NumPy dtype to an Arrow C format string."""
+    if isinstance(dtype, ArrowDtype):
+        pa_dtype = dtype.pyarrow_dtype
+        if str(pa_dtype).startswith("decimal"):
+            return f"d:{pa_dtype.precision},{pa_dtype.scale}"
+        if str(pa_dtype).startswith("timestamp["):
+            resolution = pa_dtype.unit if pa_dtype.unit == "s" else pa_dtype.unit[0]
+            return ArrowCTypes.TIMESTAMP.format(
+                resolution=resolution, tz=pa_dtype.tz or ""
+            )
+        try:
+            return PYARROW_CTYPES[str(pa_dtype)]
+        except KeyError as err:
+            raise NotImplementedError(
+                f"Conversion of {pa_dtype} to Arrow C format string is not implemented."
+            ) from err
+
+    if isinstance(dtype, CategoricalDtype):
+        return ArrowCTypes.INT64
+
+    if isinstance(dtype, pd.StringDtype):
+        return ArrowCTypes.STRING
+
+    if isinstance(dtype, DatetimeTZDtype):
+        unit = dtype.unit
+        resolution = unit if unit == "s" else unit[0]
+        return ArrowCTypes.TIMESTAMP.format(resolution=resolution, tz=dtype.tz)
+
+    np_dtype = np.dtype(dtype)
+    if np_dtype.kind == "M":
+        unit = np.datetime_data(np_dtype)[0]
+        resolution = unit if unit == "s" else unit[0]
+        return ArrowCTypes.TIMESTAMP.format(resolution=resolution, tz="")
+    if np_dtype.kind == "m":
+        unit = np.datetime_data(np_dtype)[0]
+        resolution = unit if unit == "s" else unit[0]
+        return f"tD{resolution}"
+
+    formats = {
+        "?": ArrowCTypes.BOOL,
+        "b": ArrowCTypes.INT8,
+        "B": ArrowCTypes.UINT8,
+        "h": ArrowCTypes.INT16,
+        "H": ArrowCTypes.UINT16,
+        "i": ArrowCTypes.INT32,
+        "I": ArrowCTypes.UINT32,
+        "l": ArrowCTypes.INT64 if np_dtype.itemsize == 8 else ArrowCTypes.INT32,
+        "L": ArrowCTypes.UINT64 if np_dtype.itemsize == 8 else ArrowCTypes.UINT32,
+        "q": ArrowCTypes.INT64,
+        "Q": ArrowCTypes.UINT64,
+        "e": ArrowCTypes.FLOAT16,
+        "f": ArrowCTypes.FLOAT32,
+        "d": ArrowCTypes.FLOAT64,
+        "O": ArrowCTypes.STRING,
+        "U": ArrowCTypes.STRING,
+    }
+    try:
+        return formats[np_dtype.char]
+    except KeyError as err:
+        raise NotImplementedError(
+            f"Conversion of {dtype} to Arrow C format string is not implemented."
+        ) from err
