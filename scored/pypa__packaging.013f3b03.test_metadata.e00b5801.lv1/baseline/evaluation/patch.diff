+def _decode_email_header(value: Any) -> str:
+    """Decode an email header while enforcing core metadata's UTF-8 rule."""
+    decoded: list[str] = []
+    for chunk, _encoding in email.header.decode_header(value):
+        if isinstance(chunk, bytes):
+            decoded.append(chunk.decode("utf-8"))
+        else:
+            decoded.append(chunk)
+    return "".join(decoded)
+
+
+def parse_email(data: bytes | str) -> tuple[RawMetadata, dict[str, list[str]]]:
+    """Parse distribution metadata serialized as RFC822-style headers."""
+    if isinstance(data, bytes):
+        message = email.parser.BytesParser(policy=email.policy.compat32).parsebytes(data)
+    else:
+        message = email.parser.Parser(policy=email.policy.compat32).parsestr(data)
+
+    raw: RawMetadata = {}
+    unparsed: dict[str, list[str]] = {}
+
+    # Iterating over a set of names prevents repeated headers from being processed
+    # more than once while preserving the order of their values via get_all().
+    names = list(dict.fromkeys(name.lower() for name in message.keys()))
+    for email_name in names:
+        values = message.get_all(email_name, [])
+        raw_name = _EMAIL_TO_RAW_MAPPING.get(email_name)
+        if raw_name is None:
+            unparsed[email_name] = [str(value) for value in values]
+            continue
+
+        decoded_values: list[str] = []
+        malformed = False
+        for value in values:
+            try:
+                decoded_values.append(_decode_email_header(value))
+            except (UnicodeDecodeError, LookupError, email.errors.HeaderParseError):
+                malformed = True
+                break
+        if malformed:
+            unparsed[email_name] = [str(value) for value in values]
+            continue
+
+        if raw_name in _STRING_FIELDS:
+            if len(decoded_values) == 1:
+                raw[raw_name] = decoded_values[0]  # type: ignore[literal-required]
+            else:
+                unparsed[email_name] = decoded_values
+        elif raw_name == "keywords":
+            if len(decoded_values) == 1:
+                raw["keywords"] = decoded_values[0].split(",")
+            else:
+                unparsed[email_name] = decoded_values
+        elif raw_name in _LIST_FIELDS:
+            raw[raw_name] = decoded_values  # type: ignore[literal-required]
+        elif raw_name == "project_urls":
+            project_urls: dict[str, str] = {}
+            valid = True
+            for value in decoded_values:
+                label, separator, url = value.partition(",")
+                label = label.strip()
+                url = url.strip()
+                if not separator or label in project_urls:
+                    valid = False
+                    break
+                project_urls[label] = url
+            if valid:
+                raw["project_urls"] = project_urls
+            else:
+                unparsed[email_name] = decoded_values
+
+    payload = message.get_payload(decode=True)
+    if payload is not None and payload != b"":
+        if isinstance(data, bytes):
+            try:
+                description: str | bytes = payload.decode("utf-8")
+            except UnicodeDecodeError:
+                description = payload
+        else:
+            text_payload = message.get_payload()
+            description = (
+                text_payload if isinstance(text_payload, str) else str(text_payload)
+            )
+
+        if "description" in raw:
+            header_description = raw.pop("description")
+            unparsed.setdefault("description", []).append(header_description)
+            unparsed["description"].append(description)  # type: ignore[arg-type]
+        elif "description" in unparsed:
