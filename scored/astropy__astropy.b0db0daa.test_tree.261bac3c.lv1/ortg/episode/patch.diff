+    def is_primary(self, name):
+        """Return whether *name* may be the primary word of a UCD."""
+        return name.lower() in self._primary
+
+    def is_secondary(self, name):
+        """Return whether *name* may be a secondary word of a UCD."""
+        return name.lower() in self._secondary
+
+    def normalize_capitalization(self, name):
+        """Return the vocabulary's canonical capitalization for *name*."""
+        return self._capitalizations[name.lower()]
