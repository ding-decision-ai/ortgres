+def _format_message(message, warning_class, config=None, pos=None):
+    """Format a VOTable diagnostic with its source location and category."""
+    if config is None:
+        config = {}
+    if pos is None:
+        pos = ("?", "?")
+
+    line, column = (value if value is not None else "?" for value in pos)
+    filename = config.get("filename")
+    if filename:
+        location = f"{filename}:{line}:{column}"
+    else:
+        location = f"{line}:{column}"
+    return f"{location}: {warning_class}: {message}"
+
+
+def _suppressed_warning(warning, config, stacklevel=1):
+    """Emit repeated diagnostics up to the configured warning limit."""
+    warning_class = warning.__class__
+    counts = config.setdefault("_warning_counts", {})
+    count = counts.get(warning_class, 0) + 1
+    counts[warning_class] = count
+
+    if count < conf.max_warnings:
+        warn(warning, stacklevel=stacklevel + 1)
+    elif count == conf.max_warnings:
+        warning.formatted_message += (
+            " (suppressing further warnings of this type...)"
+        )
+        warning.args = (warning.formatted_message,)
+        warn(warning, stacklevel=stacklevel + 1)
+
+
 
 
 
