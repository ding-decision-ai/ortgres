diff --git a/astropy/utils/xml/check.py b/astropy/utils/xml/check.py
index 1f711a6..5c99019 100644
--- a/astropy/utils/xml/check.py
+++ b/astropy/utils/xml/check.py
@@ -8,6 +8,53 @@ import re
 import urllib.parse
 
 
+_id_regex = re.compile(r"^[A-Za-z_][A-Za-z0-9._-]*$")
+_id_char_regex = re.compile(r"[^A-Za-z0-9._-]")
+
+
+def check_id(ID):
+    """Return whether *ID* has the lexical form of an XML ID."""
+    return isinstance(ID, str) and _id_regex.fullmatch(ID) is not None
+
+
+def fix_id(ID):
+    """Convert an arbitrary string to the lexical form of an XML ID."""
+    if not isinstance(ID, str):
+        ID = str(ID)
+    if not ID or ID[0] not in "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_":
+        ID = "_" + ID
+    return _id_char_regex.sub("_", ID)
+
+
+def check_anyuri(uri):
+    """Return whether *uri* can be parsed as an XML ``anyURI`` value."""
+    try:
+        urllib.parse.urlparse(uri)
+    except (AttributeError, TypeError, ValueError):
+        return False
+    return True
+
+
+def check_token(token):
+    """
+    Returns `True` if *token* is a valid XML token, as defined by XML
+    Schema Part 2.
+
+    XML ``token`` values may be empty, but may not contain tabs or line
+    breaks, leading or trailing spaces, or consecutive spaces.
+    """
+    if not isinstance(token, str):
+        return False
+    return (
+        "\r" not in token
+        and "\n" not in token
+        and "\t" not in token
+        and not token.startswith(" ")
+        and not token.endswith(" ")
+        and "  " not in token
+    )
+
+
 
 
 
