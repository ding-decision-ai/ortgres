@@ -73,6 +73,38 @@ class Conf(_config.ConfigNamespace):
 conf = Conf()
 
 
+def _format_message(message, warning_name, config=None, pos=None):
+    """Add source location and warning code information to a message."""
+    if config is None:
+        config = {}
+    if pos is None:
+        pos = ("?", "?")
+    filename = config.get("filename")
+    location = f"{pos[0]}:{pos[1]}"
+    if filename:
+        location = f"{filename}:{location}"
+    return f"{location}: {warning_name}: {message}"
+
+
+def _suppressed_warning(warning, config=None, stacklevel=1):
+    """Emit repeated warning classes only up to ``conf.max_warnings``."""
+    if config is None:
+        config = {}
+    counts = config.setdefault("_warning_counts", {})
+    warning_class = warning.__class__
+    count = counts.get(warning_class, 0)
+    counts[warning_class] = count + 1
+
+    if count >= conf.max_warnings:
+        return
+    if count == conf.max_warnings - 1:
+        warning.formatted_message += (
+            " (suppressing further warnings of this type...)"
+        )
+        warning.args = (warning.formatted_message,)
+    warn(warning, stacklevel=stacklevel + 1)
+
+
 
 
 
