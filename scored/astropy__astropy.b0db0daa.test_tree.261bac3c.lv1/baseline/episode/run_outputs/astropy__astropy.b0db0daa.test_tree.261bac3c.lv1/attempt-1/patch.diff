+++ b/astropy/io/votable/tree.py
@@ -294,6 +294,44 @@ def _attach_default_config(votable, config) -> dict:
 # ATTRIBUTE CHECKERS
 
 
+_astroyear_re = re.compile(r"^[JB]?[0-9]+(?:[.][0-9]*)?$")
+
+
+def _get_default_unit_format(config):
+    """Return the unit syntax prescribed by the configured VOTable version."""
+    if "version_1_4_or_later" in config:
+        version_1_4_or_later = config["version_1_4_or_later"]
+    else:
+        version = config.get("version")
+        version_1_4_or_later = (
+            version is not None and util.version_compare(str(version), "1.4") >= 0
+        )
+    return "vounit" if version_1_4_or_later else "cds"
+
+
+def _get_unit_format(config):
+    """Return an explicit unit format, or the version-dependent default."""
+    return config.get("unit_format") or _get_default_unit_format(config)
+
+
+def check_astroyear(year, field, config=None, pos=None):
+    """Validate an astronomical year value from a VOTable attribute."""
+    if year is not None and (
+        not isinstance(year, str) or _astroyear_re.fullmatch(year) is None
+    ):
+        warn_or_raise(W07, W07, (field, year), config, pos)
+        return False
+    return True
+
+
+def check_string(string, attr_name, config=None, pos=None):
+    """Validate that a VOTable attribute is a string or bytes value."""
+    if string is not None and not isinstance(string, (str, bytes)):
+        warn_or_raise(W08, W08, (attr_name,), config, pos)
+        return False
+    return True
+
+
 
 
 
