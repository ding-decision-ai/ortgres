+def extract_messages(doctree: Element) -> Iterable[tuple[Element, str]]:
+    """Extract translatable messages from a document tree."""
+
+    def clean_message(rawsource: str) -> str:
+        # A backslash at the end of an reStructuredText source line is a line
+        # continuation marker.  Work one line at a time here: besides making
+        # the intended treatment of newlines explicit, this avoids the severe
+        # backtracking that a multiline ``\s*...`` expression can exhibit on
+        # a long line.
+        lines = rawsource.replace('\r\n', '\n').replace('\r', '\n').split('\n')
+        for index, line in enumerate(lines):
+            without_trailing_space = line.rstrip(' \t')
+            if without_trailing_space.endswith('\\'):
+                lines[index] = without_trailing_space[:-1].rstrip(' \t')
+        return ' '.join(lines).strip()
+
+    for node in doctree.findall(is_translatable):
+        if isinstance(node, addnodes.translatable):
+            messages = node.extract_original_messages()
+        elif isinstance(node, LITERAL_TYPE_NODES):
+            messages = (node.rawsource or node.astext(),)
+        elif isinstance(node, IMAGE_TYPE_NODES):
+            image_messages = []
+            if node.get('alt'):
+                image_messages.append(node['alt'])
+            if node.get('translatable'):
+                image_messages.append(f'.. image:: {node["uri"]}')
+            messages = image_messages
+        elif isinstance(node, nodes.meta):
+            messages = (node.get('content', ''),)
+        else:
+            messages = (clean_message(node.rawsource),)
+
+        for message in messages:
+            if message:
+                yield node, message
+
+
 
 
 
