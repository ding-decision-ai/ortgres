+def make_id(
+    env: BuildEnvironment,
+    document: nodes.document,
+    prefix: str = '',
+    term: str | None = None,
+) -> str:
+    """Generate an appropriate node ID for *prefix* and *term*."""
+    if term is not None:
+        node_id = f'{prefix}-{term}' if prefix else term
+        node_id = node_id.lower()
+        node_id = node_id.translate(_non_id_translate_digraphs)
+        node_id = node_id.translate(_non_id_translate)
+        node_id = unicodedata.normalize('NFKD', node_id)
+        node_id = node_id.encode('ascii', 'ignore').decode('ascii')
+        node_id = _non_id_chars.sub('-', ' '.join(node_id.split()))
+        node_id = _non_id_at_ends.sub('', node_id)
+        if node_id and node_id not in document.ids:
+            return node_id
+
+    if prefix:
+        id_format = f'{prefix}-%s'
+    else:
+        id_format = f'{document.settings.id_prefix or "id"}%s'
+
+    while True:
+        node_id = id_format % env.new_serialno('index')
+        if node_id not in document.ids:
+            return node_id
