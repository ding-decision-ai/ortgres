+def extract_messages(doctree: Element) -> Iterable[tuple[Element, str]]:
+    """Extract translatable messages from a document tree."""
+    for node in doctree.findall(is_translatable):
+        if isinstance(node, addnodes.translatable):
+            for message in node.extract_original_messages():
+                if message:
+                    yield node, message
+        elif isinstance(node, LITERAL_TYPE_NODES):
+            message = node.rawsource or node.astext()
+            if message:
+                yield node, message
+        elif isinstance(node, IMAGE_TYPE_NODES):
+            if alt := node.get('alt'):
+                yield node, alt
+            if node.get('translatable'):
+                uri = node.get('original_uri', node['uri'])
+                yield node, f'.. image:: {uri}'
+        elif isinstance(node, nodes.meta):
+            if message := node.get('content'):
+                yield node, message
+        else:
+            # A backslash at the physical end of a line joins reStructuredText
+            # source lines.  Process one line at a time to keep this linear for
+            # very long inputs and to handle the final line the same way.
+            lines = []
+            for line in node.rawsource.splitlines():
+                line_without_trailing_space = line.rstrip(' \t')
+                if line_without_trailing_space.endswith('\\'):
+                    line = line_without_trailing_space[:-1].rstrip(' \t')
+                lines.append(line)
+
+            message = ' '.join(lines).strip()
+            if message:
+                yield node, message
+
+
+def split_explicit_title(text: str) -> tuple[bool, str, str]:
+    """Split role content into title and target, if given."""
+    if match := explicit_title_re.match(text):
+        opening_bracket = match.start(2) - 1
+        preceding_backslashes = 0
+        for char in reversed(text[:opening_bracket]):
+            if char != '\\':
+                break
+            preceding_backslashes += 1
+        if preceding_backslashes % 2:
+            return False, text, text
+        return True, match.group(1), match.group(2)
+    return False, text, text
+
+
+def get_node_source(node: Element) -> str:
+    for pnode in traverse_parent(node):
+        if pnode.source:
+            return pnode.source
+    msg = 'node source not found'
+    raise ValueError(msg)
+
+
 
 
 
