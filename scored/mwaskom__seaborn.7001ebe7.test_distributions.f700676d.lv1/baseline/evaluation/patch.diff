+def _parse_cubehelix_args(argstr):
+    """Parse a cubehelix palette specification string."""
+    if argstr.startswith("ch:"):
+        argstr = argstr[3:]
+
+    reverse = argstr.endswith("_r")
+    if reverse:
+        argstr = argstr[:-2]
+
+    if not argstr.strip(" "):
+        return [], {"reverse": reverse}
+
+    aliases = {
+        "s": "start",
+        "r": "rot",
+        "g": "gamma",
+        "h": "hue",
+        "l": "light",
+        "d": "dark",
+    }
+    args = []
+    kwargs = {}
+    for item in argstr.split(","):
+        if "=" in item:
+            key, value = item.split("=", 1)
+            key = key.strip(" ")
+            kwargs[aliases.get(key, key)] = float(value.strip(" "))
+        else:
+            args.append(float(item.strip(" ")))
+
+    if reverse:
+        kwargs["reverse"] = True
+
+    return args, kwargs
+
