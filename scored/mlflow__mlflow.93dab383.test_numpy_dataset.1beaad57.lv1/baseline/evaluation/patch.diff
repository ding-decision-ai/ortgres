diff --git a/mlflow/types/utils.py b/mlflow/types/utils.py
index 118156b..e824546 100644
--- a/mlflow/types/utils.py
+++ b/mlflow/types/utils.py
@@ -39,6 +39,156 @@ class TensorsNotSupportedException(MlflowException):
         super().__init__(f"Multidimensional arrays (aka tensors) are not supported. {msg}")
 
 
+def _get_tensor_shape(data, variable_dimension: int | None = 0) -> tuple[int, ...]:
+    """Return a tensor shape, marking ``variable_dimension`` as variable."""
+    from scipy.sparse import csc_matrix, csr_matrix
+
+    if not isinstance(data, (np.ndarray, csr_matrix, csc_matrix)):
+        raise TypeError(
+            "Expected data to be a numpy.ndarray, scipy.sparse.csr_matrix, or "
+            f"scipy.sparse.csc_matrix, got '{type(data)}'."
+        )
+
+    shape = tuple(data.shape)
+    if variable_dimension is None:
+        return shape
+    if not isinstance(variable_dimension, int) or not -len(shape) <= variable_dimension < len(shape):
+        raise MlflowException.invalid_parameter_value(
+            f"The specified variable_dimension {variable_dimension} is out of bounds with "
+            f"respect to the number of dimensions {len(shape)} in the input dataset"
+        )
+
+    shape = list(shape)
+    shape[variable_dimension] = -1
+    return tuple(shape)
+
+
+def clean_tensor_type(dtype: np.dtype):
+    """Remove item-size information from NumPy string and byte dtypes."""
+    if not isinstance(dtype, np.dtype):
+        raise TypeError(f"Expected `dtype` to be instance of `np.dtype`, got {type(dtype)}")
+    if dtype.char == "U":
+        return np.dtype("str")
+    if dtype.char == "S":
+        return np.dtype("bytes")
+    return dtype
+
+
+def _infer_schema(data: Any) -> Schema:
+    """Infer an MLflow :class:`Schema` from supported data containers."""
+    from scipy.sparse import csc_matrix, csr_matrix
+
+    try:
+        if isinstance(data, np.ndarray):
+            return Schema(
+                [TensorSpec(clean_tensor_type(data.dtype), _get_tensor_shape(data))]
+            )
+
+        if isinstance(data, (csr_matrix, csc_matrix)):
+            return Schema(
+                [TensorSpec(clean_tensor_type(data.dtype), _get_tensor_shape(data))]
+            )
+
+        if isinstance(data, dict):
+            if not all(isinstance(key, str) for key in data):
+                raise MlflowException(
+                    "The dictionary keys are not all strings. "
+                    f"Invalid keys: {[key for key in data if not isinstance(key, str)]}"
+                )
+            if not data:
+                raise MlflowException.invalid_parameter_value(
+                    "Schema inference is not supported for an empty dictionary."
+                )
+            if all(isinstance(value, np.ndarray) for value in data.values()):
+                return Schema(
+                    [
+                        TensorSpec(
+                            clean_tensor_type(value.dtype),
+                            _get_tensor_shape(value),
+                            name,
+                        )
+                        for name, value in data.items()
+                    ]
+                )
+            if any(isinstance(value, np.ndarray) for value in data.values()):
+                raise MlflowException("The dictionary values are not all numpy.ndarray.")
+            return Schema(
+                [
+                    ColSpec(
+                        _infer_colspec_type(value),
+                        name=name,
+                        required=not isinstance(_infer_colspec_type(value), AnyType),
+                    )
+                    for name, value in data.items()
+                ]
+            )
+
+        if isinstance(data, pd.DataFrame):
+            return Schema(
+                [
+                    ColSpec(
+                        _infer_pandas_column(data[column]),
+                        name=column,
+                        required=_infer_required(data[column]),
+                    )
+                    for column in data.columns
+                ]
+            )
+
+        if isinstance(data, pd.Series):
+            return Schema(
+                [
+                    ColSpec(
+                        _infer_pandas_column(data),
+                        name=data.name,
+                        required=_infer_required(data),
+                    )
+                ]
+            )
+
+        if _is_spark_df(data):
+            return Schema(
+                [
+                    ColSpec(
+                        _infer_spark_type(field.dataType, data, field.name),
+                        name=field.name,
+                        required=not field.nullable,
+                    )
+                    for field in data.schema.fields
+                ]
+            )
+
+        if isinstance(data, DataType):
+            return Schema([ColSpec(data)])
+
+        if isinstance(data, list):
+            if not data:
+                return Schema([ColSpec(DataType.string)])
+            inferred = _infer_colspec_type(data)
+            # A top-level list represents rows. Unwrap its outer Array layer.
+            dtype = inferred.dtype
+            if isinstance(dtype, Object):
+                return Schema(
+                    [
+                        ColSpec(prop.dtype, prop.name, required=prop.required)
+                        for prop in dtype.properties
+                    ]
+                )
+            return Schema([ColSpec(dtype)])
+
+        return Schema([ColSpec(_infer_colspec_type(data))])
+    except InvalidDataForSignatureInferenceError:
+        raise
+    except TensorsNotSupportedException:
+        raise
+    except MlflowException:
+        raise
+    except Exception as e:
+        raise MlflowException.invalid_parameter_value(
+            f"Failed to infer schema for data. Error: {e}"
+        ) from e
+
+
 
 
 
