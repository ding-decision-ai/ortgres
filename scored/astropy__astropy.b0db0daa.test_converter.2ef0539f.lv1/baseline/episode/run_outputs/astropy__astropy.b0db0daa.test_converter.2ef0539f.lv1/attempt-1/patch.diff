@@ -20,6 +20,47 @@ class UCDWords:
     file resides in data/ucd1p-words.txt.
     """
 
+    def __init__(self):
+        self._primary = set()
+        self._secondary = set()
+        self._descriptions = {}
+        self._capitalization = {}
+
+        contents = data.get_pkg_data_contents(
+            "data/ucd1p-words.txt", package="astropy.io.votable", encoding="utf-8"
+        )
+        for line in contents.splitlines():
+            line = line.strip()
+            if not line or line.startswith("#"):
+                continue
+
+            parts = line.split("|")
+            if len(parts) != 3:
+                raise ValueError(f"Invalid UCD vocabulary line: {line!r}")
+            word_type, name, description = (part.strip() for part in parts)
+            if len(word_type) != 1 or word_type not in "QPESVC":
+                raise ValueError(f"Invalid UCD word type {word_type!r}")
+
+            key = name.lower()
+            if word_type in "QPEVC":
+                self._primary.add(key)
+            if word_type in "QSEVC":
+                self._secondary.add(key)
+            self._descriptions[key] = description
+            self._capitalization[key] = name
+
+    def is_primary(self, name):
+        """Return whether *name* may be the primary word of a UCD."""
+        return name.lower() in self._primary
+
+    def is_secondary(self, name):
+        """Return whether *name* may be a secondary word of a UCD."""
+        return name.lower() in self._secondary
+
+    def normalize_capitalization(self, name):
+        """Return the spelling of *name* used by the controlled vocabulary."""
+        return self._capitalization[name.lower()]
+
 
 
 
