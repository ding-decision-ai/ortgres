+    parts = []
+    filename = config.get("filename")
+    if filename:
+        parts.append(str(filename))
+    if pos is not None:
+        parts.extend(str(value) for value in pos)
+
+    prefix = ":".join(parts)
+    if prefix:
+        prefix += ": "
+    return f"{prefix}{warning}: {message}"
+
+
+def _suppressed_warning(warning, config=None, stacklevel=1):
+    if config is None:
+        config = {}
+
+    counts = config.setdefault("_warning_counts", {})
+    warning_type = type(warning)
+    count = counts.get(warning_type, 0) + 1
+    counts[warning_type] = count
+
+    maximum = conf.max_warnings
+    if count < maximum:
+        warn(warning, stacklevel=stacklevel + 1)
+    elif count == maximum:
+        warning.formatted_message += " (suppressing further warnings of this type...)"
+        warning.args = (warning.formatted_message,)
+        warn(warning, stacklevel=stacklevel + 1)
+
+
 
 
 
