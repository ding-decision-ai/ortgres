+        unique_mask[0] = group_index[0] >= 0
+        unique_mask[1:] = group_index[1:] != group_index[:-1]
+        comp_ids = unique_mask.cumsum(dtype=np.intp) - 1
+        obs_group_ids = group_index[unique_mask]
+    else:
+        table = hashtable.Int64HashTable(len(group_index))
+        comp_ids, obs_group_ids = table.get_labels_groupby(group_index)
+        if sort and len(obs_group_ids):
+            obs_group_ids, comp_ids = _reorder_by_uniques(
+                obs_group_ids, comp_ids
+            )
+
+    return ensure_platform_int(comp_ids), ensure_int64(obs_group_ids)
+
