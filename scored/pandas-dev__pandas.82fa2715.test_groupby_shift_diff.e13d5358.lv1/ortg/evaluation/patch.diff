+                closing = ",)" if len(values) == 1 else ")"
+                candidate = "(" + ", ".join([*rendered, value]) + closing
+                if rendered and adjustment.len(candidate) > tuple_width:
+                    rendered.append("...")
+                    break
+                rendered.append(value)
+
+            if len(rendered) == 1 and len(values) == 1:
+                return f"({rendered[0]},)"
+            return f"({', '.join(rendered)})"
