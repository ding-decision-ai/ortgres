+    reverse_indexer.put(sorter, np.arange(len(sorter), dtype=np.intp))
+
+    mask = labels < 0
+    labels = reverse_indexer.take(labels)
+    np.putmask(labels, mask, -1)
+    return uniques.take(sorter), labels
