     return wrapper
 
 
+def _convert_wrapper(f, dtype):
+    def wrapper(
+        arr: np.ndarray, indexer: np.ndarray, out: np.ndarray, fill_value=np.nan
+    ) -> None:
+        f(arr.astype(dtype), indexer, out, fill_value=fill_value)
+
+    return wrapper
+
+
+def _take_nd_object(
+    arr: np.ndarray,
+    indexer: npt.NDArray[np.intp],
+    out: np.ndarray,
+    axis: AxisInt,
+    fill_value,
+    mask_info,
+) -> None:
+    """Fallback for dtypes without a specialized Cython take kernel."""
+    if mask_info is None:
+        mask = indexer == -1
+        needs_masking = bool(mask.any())
+    else:
+        mask, needs_masking = mask_info
+        if mask is None:
+            mask = indexer == -1
+
+    if not needs_masking:
+        out[...] = np.take(arr, indexer, axis=axis)
+        return
+
+    out_indexer = [slice(None)] * out.ndim
+    out_indexer[axis] = mask
+    out[tuple(out_indexer)] = fill_value
+
+    not_mask = ~mask
+    if not_mask.any():
+        out_indexer[axis] = not_mask
+        out[tuple(out_indexer)] = np.take(arr, indexer[not_mask], axis=axis)
+
+
 
 
 
