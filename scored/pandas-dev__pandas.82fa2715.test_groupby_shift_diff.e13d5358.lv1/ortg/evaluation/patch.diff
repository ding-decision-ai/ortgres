+def get_group_index_sorter(
+    group_index: npt.NDArray[np.intp], ngroups: int | None = None
+) -> npt.NDArray[np.intp]:
+    """Return a stable indexer that makes equal group ids contiguous."""
+    if ngroups is None:
+        ngroups = 1 + int(group_index.max()) if len(group_index) else 0
+    sorter, _ = algos.groupsort_indexer(
+        ensure_platform_int(group_index), ngroups
+    )
+    return ensure_platform_int(sorter)
