+def is_int64_overflow_possible(shape: Shape) -> bool:
+    """Whether the product of *shape* cannot be represented by int64."""
+    the_prod = 1
+    for size in shape:
+        the_prod *= int(size)
+        if the_prod > lib.i8max:
+            return True
+    return False
