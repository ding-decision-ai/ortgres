+    @final
+    def sample(
+        self,
+        n: int | None = None,
+        frac: float | None = None,
+        replace: bool = False,
+        weights: Sequence | Series | None = None,
+        random_state: RandomState | None = None,
+    ):
+        """
+        Return a random sample of items from each group.
+
+        Each group is sampled independently. The selected rows retain their
+        original index labels and are returned in group iteration order.
+
+        Parameters
+        ----------
+        n : int, optional
+            Number of items to return for each group. Cannot be used with
+            ``frac``. Defaults to one when ``frac`` is not specified.
+        frac : float, optional
+            Fraction of items to return from each group.
+        replace : bool, default False
+            Allow sampling of the same row more than once.
+        weights : sequence or Series, optional
+            Sampling weights. Series weights align to the selected object's
+            index; weights are normalized separately within each group.
+        random_state : int, ndarray, BitGenerator, RandomState, Generator, optional
+            Random state used across all groups.
+
+        Returns
+        -------
+        Series or DataFrame
+            Rows sampled from each group, with their original labels.
+        """
+        selected_obj = self._selected_obj
+        if selected_obj.empty:
+            return selected_obj
+
+        size = sample.process_sampling_size(n, frac, replace)
+        if weights is not None:
+            weights_arr = sample.preprocess_weights(selected_obj, weights, axis=0)
+        else:
+            weights_arr = None
+
+        random_state = com.random_state(random_state)
+
+        group_ids = self._grouper.ids
+        valid = group_ids >= 0
+        group_sizes = np.bincount(
+            group_ids[valid], minlength=self._grouper.ngroups
+        )
+        # Stable sorting keeps rows in their original order within each group.
+        # Group numbers correspond to result_index, i.e. group iteration order.
+        sorter = np.argsort(group_ids, kind="stable")
+        sorter = sorter[group_ids[sorter] >= 0]
+
+        sampled_indices: list[npt.NDArray[np.intp]] = []
+        start = 0
+        for group_size in group_sizes:
+            group_indices = sorter[start : start + group_size]
+            start += group_size
+
+            if size is None:
+                assert frac is not None
+                sample_size = round(frac * group_size)
+            else:
+                sample_size = size
+
+            if weights_arr is None:
+                group_weights = None
+            else:
+                group_weights = weights_arr[group_indices]
+
+            sampled = sample.sample(
+                group_size,
+                sample_size,
+                replace,
+                group_weights,
+                random_state,
+            )
+            sampled_indices.append(group_indices[sampled])
+
+        if sampled_indices:
+            sampled_indices_array = np.concatenate(sampled_indices)
+        else:
+            sampled_indices_array = np.array([], dtype=np.intp)
+        return selected_obj.take(sampled_indices_array, axis=0)
+
