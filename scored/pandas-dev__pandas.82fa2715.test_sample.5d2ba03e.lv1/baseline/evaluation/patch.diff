+def random_state(state: RandomState | None = None) -> RandomState:
+    """Turn a supported seed into a NumPy random-state object."""
+    if is_integer(state) or isinstance(state, (np.ndarray, np.random.BitGenerator)):
+        return np.random.RandomState(state)
+    if isinstance(state, (np.random.RandomState, np.random.Generator)):
+        return state
+    if state is None:
+        return np.random
+
+    raise ValueError(
+        "random_state must be an integer, array-like, a BitGenerator, Generator, "
+        "a numpy RandomState, or None"
+    )
+
