+def get_group_index(
+    labels: Sequence[np.ndarray], shape: Shape, sort: bool, xnull: bool
+) -> npt.NDArray[np.int64]:
+    """Encode a cartesian product of integer labels into flat group ids."""
+    labels = [ensure_int64(x) for x in labels]
+    shape = tuple(int(x) for x in shape)
+
+    if any(size == 0 for size in shape):
+        return np.full(len(labels[0]), -1, dtype=np.int64)
+
+    if not xnull:
+        lifted = []
+        new_shape = []
+        for lab, size in zip(labels, shape, strict=True):
+            if (lab == -1).any():
+                lab = lab + 1
+                size += 1
+            lifted.append(lab)
+            new_shape.append(size)
+        labels = lifted
+        shape = tuple(new_shape)
+
+    while True:
+        nlev = 1
+        prod = int(shape[0]) if shape else 1
+        while nlev < len(shape) and prod <= lib.i8max // max(int(shape[nlev]), 1):
+            prod *= int(shape[nlev])
+            nlev += 1
+
+        stride = np.prod(shape[1:nlev], dtype="i8") if nlev > 1 else 1
+        out = labels[0] * stride
+        for i in range(1, nlev):
+            stride //= shape[i]
+            out += labels[i] * stride
+
+        if xnull:
+            mask = labels[0] == -1
+            for lab in labels[1:nlev]:
+                mask |= lab == -1
+            out[mask] = -1
+
+        if nlev == len(shape):
+            return ensure_int64(out)
+
+        comp_ids, obs_ids = compress_group_index(out, sort=sort)
+        labels = [comp_ids] + labels[nlev:]
+        shape = (len(obs_ids),) + shape[nlev:]
+
+
+def compress_group_index(
+    group_index: npt.NDArray[np.int64], sort: bool = True
+) -> tuple[npt.NDArray[np.int64], npt.NDArray[np.int64]]:
+    """Compress arbitrary group ids to consecutive ids."""
+    if len(group_index) == 0:
+        empty = np.empty(0, dtype=np.int64)
+        return empty, empty
+
+    mapping = {}
+    observed = []
+    comp = np.empty(len(group_index), dtype=np.int64)
+    for i, value in enumerate(group_index):
+        key = int(value)
+        if key < 0:
+            comp[i] = -1
+            continue
+        if key not in mapping:
+            mapping[key] = len(observed)
+            observed.append(key)
+        comp[i] = mapping[key]
+    obs = np.asarray(observed, dtype=np.int64)
+
+    if sort and len(obs) > 1:
+        sorter = obs.argsort()
+        reverse = np.empty(len(sorter), dtype=np.int64)
+        reverse[sorter] = np.arange(len(sorter))
+        comp = reverse[comp]
+        obs = obs[sorter]
