+def _get_combined_index(
+    indexes: list[Index], intersect: bool = False, sort: bool = False
+) -> Index:
+    """Return the union or intersection of a sequence of indexes."""
+    distinct: list[Index] = []
+    seen: set[int] = set()
+    for index in indexes:
+        if id(index) not in seen:
+            seen.add(id(index))
+            distinct.append(index)
+
+    if not distinct:
+        index = default_index(0)
+    elif len(distinct) == 1:
+        index = distinct[0]
+    elif intersect:
+        index = distinct[0]
+        for other in distinct[1:]:
+            index = index.intersection(other)
+    else:
+        index = union_indexes(distinct, sort=False)
+
+    if sort:
+        index = safe_sort_index(index)
+    return index
+
