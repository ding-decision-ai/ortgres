+def _int64_cut_off(shape: Sequence[int]) -> int:
+    acc = 1
+    for i, size in enumerate(shape):
+        acc *= int(size)
+        if acc >= lib.i8max:
+            return i
+    return len(shape)
+
+
+def get_group_index(
+    labels: Sequence[npt.NDArray[np.signedinteger]],
+    shape: Shape,
+    sort: bool,
+    xnull: bool,
+) -> npt.NDArray[np.int64]:
+    """Encode label combinations as flat int64 group ids."""
+    labs = [ensure_int64(x) for x in labels]
+    shape_list = [int(x) for x in shape]
+
+    if not xnull:
+        for i, lab in enumerate(labs):
+            if (lab == -1).any():
+                labs[i] = lab + 1
+                shape_list[i] += 1
+
+    while True:
+        nlev = _int64_cut_off(shape_list)
+        if nlev == 0:
+            nlev = 1
+        stride = np.prod(shape_list[1:nlev], dtype="i8")
+        out = labs[0] * stride
+        for i in range(1, nlev):
+            stride //= shape_list[i]
+            out += labs[i] * stride
+
+        if xnull:
+            mask = labs[0] == -1
+            for lab in labs[1:nlev]:
+                mask |= lab == -1
+            out[mask] = -1
+
+        if nlev == len(shape_list):
+            return ensure_int64(out)
+
+        comp_ids, obs_ids = compress_group_index(out, sort=sort)
+        labs = [comp_ids] + labs[nlev:]
+        shape_list = [len(obs_ids)] + shape_list[nlev:]
+
+
+def compress_group_index(
+    group_index: npt.NDArray[np.int64], sort: bool = True
+) -> tuple[npt.NDArray[np.int64], npt.NDArray[np.int64]]:
+    """Compress arbitrary non-negative group ids to a dense range."""
+    values = ensure_int64(group_index)
+    uniques: list[int] = []
+    positions: dict[int, int] = {}
+    comp = np.full(len(values), -1, dtype=np.int64)
+    for i, val in enumerate(values):
+        key = int(val)
+        if key < 0:
+            continue
+        loc = positions.get(key)
+        if loc is None:
+            loc = len(uniques)
+            positions[key] = loc
+            uniques.append(key)
+        comp[i] = loc
+
+    obs = np.asarray(uniques, dtype=np.int64)
+    if sort and len(obs):
+        sorter = obs.argsort()
+        reverse = np.empty(len(sorter), dtype=np.int64)
+        reverse[sorter] = np.arange(len(sorter), dtype=np.int64)
+        mask = comp >= 0
+        comp[mask] = reverse[comp[mask]]
+        obs = obs[sorter]
+    return comp, obs
