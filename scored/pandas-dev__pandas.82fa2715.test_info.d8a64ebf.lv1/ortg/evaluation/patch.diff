+def find_common_type(types: list[DtypeObj]) -> DtypeObj:
+    """Return a common dtype without lossy boolean/numeric promotion."""
+    if not types:
+        raise ValueError("no types given")
+    first = types[0]
+    if all(dtype == first for dtype in types[1:]):
+        return first
+
+    unique_types = list(dict.fromkeys(types))
+    if any(isinstance(dtype, ExtensionDtype) for dtype in unique_types):
+        for dtype in unique_types:
+            if isinstance(dtype, ExtensionDtype):
+                common = dtype._get_common_dtype(unique_types)
+                if common is not None:
+                    return common
+        return np.dtype("object")
+
+    np_types = [np.dtype(dtype) for dtype in unique_types]
+    if all(dtype.kind == "M" for dtype in np_types) or all(
+        dtype.kind == "m" for dtype in np_types
+    ):
+        return np.result_type(*np_types)
+    if any(dtype.kind == "b" for dtype in np_types) and any(
+        dtype.kind in "iufc" for dtype in np_types
+    ):
