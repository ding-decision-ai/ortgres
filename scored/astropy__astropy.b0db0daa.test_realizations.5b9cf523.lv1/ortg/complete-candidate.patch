     _default_value: ClassVar[str] = "Planck18"
     _value: ClassVar[str | Cosmology] = "Planck18"
 
+    @classmethod
+    def validate(cls, value: Cosmology | str | None) -> Cosmology | None:
+        """Validate and resolve a default cosmology specification."""
+        if value is None:
+            value = cls._default_value
+
+        if isinstance(value, str):
+            if value == "no_default":
+                return None
+
+            from astropy.cosmology import realizations
+
+            if value not in realizations.available:
+                raise ValueError(
+                    f"Unknown cosmology {value!r}. "
+                    f"Valid cosmologies are {realizations.available}."
+                )
+            return getattr(realizations, value)
+
+        if not isinstance(value, Cosmology):
+            raise TypeError(
+                "default_cosmology must be a string or Cosmology instance"
+            )
+        return value
