+def _read_ecsv_table(filename: PathLike | ReadableFileLike[Table]) -> QTable:
+    """Read the ECSV subset used to store cosmology realizations."""
+    with get_readable_fileobj(filename, encoding="utf-8") as fileobj:
+        text = fileobj.read()
+
+    header_lines = []
+    data_lines = []
+    for line in text.splitlines():
+        stripped = line.strip()
+        if not data_lines and stripped.startswith("#"):
+            content = stripped[1:]
+            header_lines.append(content[1:] if content.startswith(" ") else content)
+        elif stripped:
+            data_lines.append(line)
+
+    if not header_lines or not header_lines[0].startswith("%ECSV"):
+        raise ValueError("ECSV header line not found")
+    if not data_lines:
+        raise ValueError("ECSV table contains no column header")
+
+    class ECSVLoader(yaml.SafeLoader):
+        pass
+
+    def construct_unit(loader: ECSVLoader, node: yaml.MappingNode) -> u.UnitBase:
+        return u.Unit(loader.construct_mapping(node, deep=True)["unit"])
+
+    def construct_quantity(
+        loader: ECSVLoader, node: yaml.MappingNode
+    ) -> u.Quantity:
+        value = loader.construct_mapping(node, deep=True)
+        return u.Quantity(value["value"], value["unit"])
+
+    ECSVLoader.add_constructor("!astropy.units.Unit", construct_unit)
+    ECSVLoader.add_constructor("!astropy.units.Quantity", construct_quantity)
+    ECSVLoader.add_constructor(
+        "!astropy.table.SerializedColumn",
+        lambda loader, node: loader.construct_mapping(node, deep=True),
+    )
+    header = yaml.load("\n".join(header_lines[1:]), Loader=ECSVLoader)
+    descriptors = header["datatype"]
+    delimiter = header.get("delimiter", " ")
+    rows = list(
+        csv.reader(
+            data_lines,
+            delimiter=delimiter,
+            quotechar='"',
+            skipinitialspace=delimiter == " ",
+        )
+    )
+    names = rows.pop(0)
+    expected_names = [descriptor["name"] for descriptor in descriptors]
+    if names != expected_names:
+        raise ValueError(
+            f"ECSV data columns {names} do not match metadata {expected_names}"
+        )
+
+    columns: dict[str, Any] = {}
+    for index, descriptor in enumerate(descriptors):
+        dtype = descriptor["datatype"]
+        subtype = descriptor.get("subtype")
+        values = []
+        for row in rows:
+            if len(row) != len(names):
+                raise ValueError("ECSV row has an inconsistent number of columns")
+            value = row[index]
+            if dtype == "string":
+                if subtype:
+                    base_dtype = subtype.split("[", 1)[0]
+                    decoded = json.loads(value)
+                    value = (
+                        decoded
+                        if base_dtype == "json"
+                        else np.asarray(decoded, dtype=base_dtype)
+                    )
+            elif dtype == "bool":
+                if value not in ("True", "False", "1", "0"):
+                    raise ValueError(f"invalid boolean value {value!r}")
+                value = value in ("True", "1")
+            else:
+                value = np.asarray(value, dtype=dtype)[()]
+            values.append(value)
+
+        unit = descriptor.get("unit")
+        if unit is not None:
+            columns[descriptor["name"]] = u.Quantity(values, unit=u.Unit(unit))
+        elif subtype and subtype.split("[", 1)[0] != "json":
+            columns[descriptor["name"]] = np.asarray(values)
+        else:
+            columns[descriptor["name"]] = values
+
+    metadata = dict(header.get("meta", {}))
+    metadata.pop("__serialized_columns__", None)
+    return QTable(columns, meta=metadata)
+
