+def __getattr__(name: str) -> Cosmology:
+    """Load and cache a built-in cosmology realization on first access."""
+    if name not in available:
+        raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+
+    cosmology = Cosmology.read(
+        _COSMOLOGY_DATA_DIR / f"{name}.ecsv", format="ascii.ecsv"
+    )
+    setattr(sys.modules[__name__], name, cosmology)
+    return cosmology
+
+
+def __dir__() -> list[str]:
+    """Directory, including lazily imported cosmology realizations."""
+    return __all__
