+) -> type[_CosmoT]:
+    """Resolve and consume the cosmology class for a mapping conversion."""
+    if cosmology is None:
+        try:
+            cosmology = params.pop("cosmology")
+        except KeyError:
+            raise ValueError(
+                "the mapping must contain a 'cosmology' key or a cosmology "
+                "class must be supplied"
+            ) from None
+    else:
+        params.pop("cosmology", None)
+
+    if isinstance(cosmology, str):
