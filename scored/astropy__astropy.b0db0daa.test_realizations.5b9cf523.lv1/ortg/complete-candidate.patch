+def _rename_map(mapping: _MapT, renames: Mapping[str, str]) -> _MapT:
+    """Rename mapping keys, rejecting ambiguous destination names."""
+    common = set(mapping).intersection(renames.values())
+    if common:
+        raise ValueError(
+            "'renames' values must be disjoint from 'map' keys, "
+            f"the common keys are: {common}"
+        )
+
+    for old, new in renames.items():
+        mapping[new] = mapping.pop(old)
+    return mapping
+
+
