+def _distribution_type():
+    # Import lazily: core imports the registries in this module.
+    from .core import Distribution
+
+    return Distribution
+
+
+def _common_n_samples(arrays):
+    Distribution = _distribution_type()
+    counts = {array.n_samples for array in arrays if isinstance(array, Distribution)}
+    if not counts:
+        raise NotImplementedError
+    if len(counts) != 1:
+        raise ValueError("all Distribution inputs must have the same number of samples")
+    return counts.pop()
+
+
+@dispatched_function
+def empty_like(
+    prototype, dtype=None, order="K", subok=True, shape=None, *, device=None
+):
+    """Create an empty Distribution with the same number of samples."""
+    Distribution = _distribution_type()
+    if not isinstance(prototype, Distribution):
+        raise NotImplementedError
+
+    sample_shape = prototype.distribution.shape
+    if shape is not None:
+        if np.isscalar(shape):
+            shape = (shape,)
+        else:
+            shape = tuple(shape)
+        sample_shape = shape + (prototype.n_samples,)
+
+    kwargs = {
+        "dtype": dtype,
+        "order": order,
+        "subok": subok,
+        "shape": sample_shape,
+    }
+    if device is not None:
+        kwargs["device"] = device
+    return Distribution(np.empty_like(prototype.distribution, **kwargs))
+
+
+@dispatched_function
+def broadcast_to(array, shape, subok=False):
+    """Broadcast logical Distribution axes while retaining the sample axis."""
+    Distribution = _distribution_type()
+    if not isinstance(array, Distribution):
+        raise NotImplementedError
+    if np.isscalar(shape):
+        shape = (shape,)
+    result = np.broadcast_to(
+        array.distribution, tuple(shape) + (array.n_samples,), subok=subok
+    )
+    return Distribution(result)
+
+
+@dispatched_function
+def broadcast_arrays(*args, subok=False):
+    """Broadcast Distribution and ordinary inputs over their logical shapes."""
+    Distribution = _distribution_type()
+    n_samples = _common_n_samples(args)
+    shape = np.broadcast_shapes(*(arg.shape for arg in args))
+    result = []
+    for arg in args:
+        if isinstance(arg, Distribution):
+            samples = np.broadcast_to(
+                arg.distribution, shape + (n_samples,), subok=subok
+            )
+            result.append(Distribution(samples))
+        else:
+            result.append(np.broadcast_to(arg, shape, subok=subok))
+    return result
+
+
+@dispatched_function
+def concatenate(
+    arrays, axis=0, out=None, *, dtype=None, casting="same_kind"
