+    def activate(self) -> None:
+        with self._activation_lock:
+            if self.is_active or self._is_stopped:
+                return
+            self.is_active = True
+            self._threads.extend(
+                threading.Thread(
+                    target=self._consumer,
+                    name=f"mlflow-telemetry-consumer-{index}",
+                    daemon=True,
+                )
+                for index in range(self._max_workers)
+            )
+            for thread in self._threads:
+                thread.start()
+            self._config_thread = threading.Thread(
+                target=self._fetch_config,
+                name="mlflow-telemetry-config",
+                daemon=True,
+            )
+            self._config_thread.start()
+            atexit.register(self._at_exit_callback)
+            self._atexit_registered = True
+
+    def add_record(self, record: Record):
+        if self._is_stopped:
+            return
+        if not self.is_active:
+            self.activate()
+        if self._is_stopped:
+            return
+        with self._batch_lock:
+            if self._is_stopped:
+                return
+            self._pending_records.append(record)
+            if len(self._pending_records) >= self._batch_size:
+                self._send_batch()
+
+    def _send_batch(self) -> None:
+        """Enqueue the current batch, retaining it when the queue is full."""
+        if not self._pending_records:
+            return
+        try:
+            self._queue.put_nowait(self._pending_records)
+            self._pending_records = []
+            self._last_batch_time = time.time()
+        except Full:
+            _log_error("Failed to add telemetry records to queue: the queue is full")
+
+    def flush(self, terminate=False) -> None:
+        if not self.is_active:
+            return
+        if terminate:
+            self._is_stopped = True
+            self.is_active = False
+            return
+        if self._config_thread is not None and self._config_thread.is_alive():
+            self._config_thread.join(timeout=1)
+        if self.config is not None and not self._is_stopped:
+            with self._batch_lock:
+                self._send_batch()
+        try:
+            self._queue.join()
+        except Exception as e:
+            _log_error(f"Failed to flush telemetry records: {e}")
 
