+                return
+            rollout_percentage = config.get("rollout_percentage", 100)
+            if not isinstance(rollout_percentage, (int, float)):
+                return
+            if rollout_percentage <= 0 or random.random() * 100 > rollout_percentage:
+                return
+            self.config = TelemetryConfig(
+                ingestion_url=ingestion_url,
+                disable_events=set(config.get("disable_events", [])),
+            )
+        except (requests.exceptions.RequestException, ConnectionError, TimeoutError):
+            return
+        except Exception as e:
