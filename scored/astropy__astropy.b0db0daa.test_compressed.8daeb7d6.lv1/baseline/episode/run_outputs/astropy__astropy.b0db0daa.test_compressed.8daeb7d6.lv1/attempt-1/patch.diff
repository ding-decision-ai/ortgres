+def _parse_ascii_tformat(tform, strict=False):
+    """Parse an ASCII-table ``TFORMn`` value."""
+    try:
+        match = TFORMAT_ASCII_RE.fullmatch(tform.strip().upper())
+    except (AttributeError, TypeError):
+        match = None
+
+    if match is None:
+        raise VerifyError(f"Format {tform!r} is not recognized.")
+
+    groups = match.groupdict()
+    format_ = (groups["format"] or groups["formatf"]).upper()
+    width_text = groups["width"] or groups["widthf"]
+    precision_text = groups["precision"]
+
+    if width_text is None:
+        if strict:
+            raise VerifyError(f"Format {tform!r} is not recognized.")
+        width, precision = ASCII_DEFAULT_WIDTHS[format_]
+    else:
+        width = int(width_text)
+        if format_ in "EFD":
+            if precision_text is None:
+                if strict:
+                    raise VerifyError(f"Format {tform!r} is not recognized.")
+                precision = 1
+            else:
+                precision = int(precision_text)
+        else:
+            precision = 0
+
+    if width <= 0 or precision >= width:
+        raise VerifyError(f"Format {tform!r} is not recognized.")
+
+    return format_, width, precision
+
 
 
 
