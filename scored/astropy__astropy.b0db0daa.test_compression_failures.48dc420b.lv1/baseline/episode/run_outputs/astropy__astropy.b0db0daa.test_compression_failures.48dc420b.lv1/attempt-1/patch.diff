+def _check_compressed_header(header):
+    """Validate header values needed by the tiled-compression machinery."""
+    required = ("ZBITPIX", "ZNAXIS", "ZCMPTYPE")
+    missing = [keyword for keyword in required if keyword not in header]
+    if missing:
+        raise ValueError(
+            "Compressed image header is missing required keyword(s): "
