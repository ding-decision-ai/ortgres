+
+    for axis in range(1, znaxis + 1):
+        dimension = header.get(f"ZNAXIS{axis}")
+        tile = header.get(f"ZTILE{axis}", dimension)
+        if not isinstance(dimension, (int, np.integer)) or dimension < 0:
+            raise ValueError(f"Invalid value for ZNAXIS{axis}: {dimension!r}")
