+def setitem_datetimelike_compat(values: np.ndarray, num_set: int, other):
+    """
+    Preprocess datetime-like values before assignment to a NumPy object array.
+
+    Parameters
+    ----------
+    values : np.ndarray
+        The prospective target array; this function only inspects its dtype.
+    num_set : int
+        Number of elements to be set.
+    other : Any
+        The value or values to be assigned.
+
+    Returns
+    -------
+    Any
+        The processed value. The caller performs the actual assignment.
+    """
+    if values.dtype == object:
+        dtype, _ = infer_dtype_from(other)
+        if dtype.kind in "mM":
+            # NumPy may cast timedelta64 values to integers when assigning
+            # directly into an object array (numpy issue #12550).
+            if not is_list_like(other):
+                other = [other] * num_set
+            else:
+                other = list(other)
+
+    return other
+
