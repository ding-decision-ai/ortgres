+def _format_float(value):
+    """Format a floating-point value for a FITS card value field."""
+    value_str = str(value).upper()
+    if len(value_str) > 20:
+        value_str = f"{value:.16G}"
+    if len(value_str) > 20 and "E" in value_str:
+        mantissa, exponent = value_str.split("E")
+        mantissa = mantissa[: 19 - len(exponent)]
+        value_str = mantissa.rstrip(".") + "E" + exponent
+    elif len(value_str) > 20:
+        value_str = value_str[:20].rstrip(".")
+
+    if "." not in value_str and "E" not in value_str:
+        value_str += ".0"
+    return value_str
+
+
+def _pad(input):
+    """Pad a card image to a positive multiple of 80 characters."""
+    remainder = len(input) % CARD_LENGTH
+    if remainder:
+        return input + " " * (CARD_LENGTH - remainder)
+    if not input:
+        return BLANK_CARD
+    return input
