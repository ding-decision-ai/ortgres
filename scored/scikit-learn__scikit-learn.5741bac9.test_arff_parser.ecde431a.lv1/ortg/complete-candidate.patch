+def _parse_values(s):
+    """Parse a dense or sparse ARFF data row into Python values."""
+    if _RE_SPARSE_LINE.match(s):
+        if s.strip() == "{}":
+            return {}
+        values = {}
+        position = 0
+        for match in _RE_SPARSE_KEY_VALUES.finditer(s):
+            if match.start() != position:
+                raise BadDataFormat(s)
+            key, value = match.group(1, 2)
+            if key is None:
+                raise BadDataFormat(s)
+            key = int(key)
+            if key in values:
+                raise BadDataFormat(s)
+            values[key] = _unquote(value)
+            position = match.end()
+
+        if s[position:].strip() != "}":
+            raise BadDataFormat(s)
+        return values
+
+    source = "," + s
+    values = []
+    position = 0
+    for match in _RE_DENSE_VALUES.finditer(source):
+        if source[position : match.start()].strip() or match.group(2) is not None:
+            raise BadDataFormat(s)
+        values.append(_unquote(match.group(1)))
+        position = match.end()
+
+    if source[position:].strip():
+        raise BadDataFormat(s)
+    return values
+
+
 
 
 
