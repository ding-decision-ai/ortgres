+def _parse_comma_separated_list(value: str | None) -> list[str]:
+    """Parse a comma-separated environment variable into non-empty values."""
+    if not value:
+        return []
+    return [item.strip() for item in value.split(",") if item.strip()]
 
 
+def get_allowed_hosts_from_env() -> list[str]:
+    """Get allowed Host patterns configured through the environment."""
+    return _parse_comma_separated_list(MLFLOW_SERVER_ALLOWED_HOSTS.get())
 
 
+def get_allowed_origins_from_env() -> list[str]:
+    """Get allowed CORS origins configured through the environment."""
+    return _parse_comma_separated_list(MLFLOW_SERVER_CORS_ALLOWED_ORIGINS.get())
 
 
+def get_default_allowed_hosts() -> list[str]:
+    """Return the localhost and private-network Host patterns allowed by default."""
+    allowed_hosts = []
+    for host in LOCALHOST_VARIANTS:
+        allowed_hosts.extend([host, f"{host}:*"])
 
+    allowed_hosts.extend(["10.*", "192.168.*"])
+    allowed_hosts.extend(
+        f"172.{second_octet}.*"
+        for second_octet in range(PRIVATE_172_RANGE_START, PRIVATE_172_RANGE_END)
+    )
+    return allowed_hosts
 
 
+def is_allowed_host_header(allowed_hosts: list[str], host: str) -> bool:
+    """Return whether a non-empty Host header matches an allowed Host pattern."""
+    if not host:
+        return False
+    if "*" in allowed_hosts:
+        return True
 
+    for pattern in allowed_hosts:
+        if "*" in pattern:
+            # A leading '[' denotes a bracketed IPv6 address here, not an
+            # fnmatch character class. Preserve normal fnmatch semantics for
+            # every other pattern.
+            fnmatch_pattern = f"[[]{pattern[1:]}" if pattern.startswith("[") else pattern
+            if fnmatch.fnmatchcase(host, fnmatch_pattern):
+                return True
+        elif host == pattern:
+            return True
+    return False
 
 
