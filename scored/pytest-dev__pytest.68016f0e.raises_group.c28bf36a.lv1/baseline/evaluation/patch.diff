+    def _check_exceptions(
+        self,
+        _exception: BaseException,
+        actual_exceptions: Sequence[BaseException],
+    ) -> bool:
+        """Greedily pair expected and actual exceptions and explain failures."""
+        results = ResultHolder(self.expected_exceptions, actual_exceptions)
+        matched_actual: dict[int, int] = {}
+        unmatched_expected: list[int] = []
+
+        # Expected items are considered in declaration order and are paired with
+        # the first still-unpaired actual item which matches.  This ordering is a
+        # documented part of RaisesGroup's behaviour.
+        for expected_index, expected in enumerate(self.expected_exceptions):
+            for actual_index, actual in enumerate(actual_exceptions):
+                if actual_index in matched_actual:
+                    continue
+                result = self._check_expected(expected, actual)
+                results.set_result(expected_index, actual_index, result)
+                if result is None:
+                    matched_actual[actual_index] = expected_index
+                    break
+            else:
+                unmatched_expected.append(expected_index)
+
+        unmatched_actual = [
+            index
+            for index in range(len(actual_exceptions))
+            if index not in matched_actual
+        ]
+        if not unmatched_expected and not unmatched_actual:
+            return True
+
+        # A single failed pair already has the clearest possible explanation.
+        if (
+            len(self.expected_exceptions) == 1
+            and len(actual_exceptions) == 1
+            and unmatched_expected
+        ):
+            result = results.get_result(0, 0)
+            assert isinstance(result, str)
+            self._fail_reason = result
+            return False
+
+        # These two common cardinality mismatches don't need a full matrix.
+        if unmatched_expected and not unmatched_actual:
+            not_matched = ", ".join(
+                self._repr_expected(self.expected_exceptions[index])
+                for index in unmatched_expected
+            )
+            self._fail_reason = (
+                f"Too few exceptions raised, found no match for: [{not_matched}]"
+            )
+            return False
+        if unmatched_actual and not unmatched_expected:
+            noun = "exception" if len(matched_actual) == 1 else "exceptions"
+            unexpected = [actual_exceptions[index] for index in unmatched_actual]
+            self._fail_reason = (
+                f"{len(matched_actual)} matched {noun}. "
+                f"Unexpected exception(s): {unexpected!r}"
+            )
+            return False
+
+        # Complete the relevant cells lazily.  Besides making the diagnostics
+        # useful, caching avoids evaluating a check predicate twice for one pair.
+        for actual_index in unmatched_actual:
+            for expected_index in unmatched_expected:
+                if results.get_result(expected_index, actual_index) is NotChecked:
+                    results.set_result(
+                        expected_index,
+                        actual_index,
+                        self._check_expected(
+                            self.expected_exceptions[expected_index],
+                            actual_exceptions[actual_index],
+                        ),
+                    )
+
+        lines: list[str] = []
+        matched_count = len(matched_actual)
+        if matched_count:
+            noun = "exception" if matched_count == 1 else "exceptions"
+            lines.append(f"{matched_count} matched {noun}.")
+
+        for expected_index in unmatched_expected:
+            expected = self.expected_exceptions[expected_index]
+            lines.append(f"{self._repr_expected(expected)}:")
+
+            # First mention matching exceptions which the greedy pass already
+            # paired with an earlier expectation.  This makes ordering failures
+            # understandable instead of presenting them as a regex/type failure.
+            for actual_index, paired_expected_index in matched_actual.items():
+                result = results.get_result(expected_index, actual_index)
+                if result is NotChecked:
+                    result = self._check_expected(
+                        expected, actual_exceptions[actual_index]
+                    )
+                    results.set_result(expected_index, actual_index, result)
+                if result is None:
+                    paired_expected = self.expected_exceptions[paired_expected_index]
+                    lines.append(
+                        f"  It matches {actual_exceptions[actual_index]!r} "
+                        "which was paired with "
+                        f"{self._repr_expected(paired_expected)}"
+                    )
+
+            for actual_index in unmatched_actual:
+                result = results.get_result(expected_index, actual_index)
+                assert isinstance(result, str)
+                lines.append(f"  {actual_exceptions[actual_index]!r}:")
+                lines.extend(indent(result, "    ").splitlines())
+
+        self._fail_reason = "\n".join(lines)
+        return False
+
+
 
 
 
