+def dummy_highlighter(source: str, lexer: Literal["diff", "python"] = "python") -> str:
+    """Return *source* unchanged.
+
+    Assertion helpers accept a highlighter so terminal output can be colored.  Some
+    callers (notably exception matching) need the same diff without terminal
+    formatting, and use this deliberately no-op implementation.
+    """
+    return source
+
+
+def _diff_text(
+    left: str,
+    right: str,
+    highlighter: _HighlightFunc,
+    verbose: int = 0,
+) -> list[str]:
+    """Return a line-oriented diff of two strings.
+
+    ``left`` is the obtained value and ``right`` the expected value, matching the
+    ordering used by the rest of the assertion explanation code.
+    """
+    from difflib import ndiff
+
+    explanation: list[str] = []
+    if left.isspace() and right.isspace():
+        explanation.append(
+            "Strings contain only whitespace, escaping them using repr()"
+        )
+        left = repr(left)
+        right = repr(right)
+
+    if verbose < 1:
+        common_prefix = 0
+        for left_char, right_char in zip(left, right):
+            if left_char != right_char:
+                break
+            common_prefix += 1
+        if common_prefix > 42:
+            common_prefix -= 10
+            explanation.append(
+                f"Skipping {common_prefix} identical leading characters in diff, "
+                "use -v to show"
+            )
+            left = left[common_prefix:]
+            right = right[common_prefix:]
+
+        # Only trim the suffix when both remaining strings have the same length.
+        # This prevents a suffix from being mistaken for corresponding text after
+        # an insertion or deletion.
+        if len(left) == len(right):
+            common_suffix = 0
+            for left_char, right_char in zip(reversed(left), reversed(right)):
+                if left_char != right_char:
+                    break
+                common_suffix += 1
+            if common_suffix > 42:
+                common_suffix -= 10
+                explanation.append(
+                    f"Skipping {common_suffix} identical trailing characters in diff, "
+                    "use -v to show"
+                )
+                left = left[:-common_suffix]
+                right = right[:-common_suffix]
+
+    keepends = True
+    diff = "\n".join(
+        line.rstrip("\n")
+        for line in ndiff(
+            right.splitlines(keepends),
+            left.splitlines(keepends),
+        )
+    )
+    explanation.extend(highlighter(diff, lexer="diff").splitlines())
+    return explanation
+
+
 
 
 
