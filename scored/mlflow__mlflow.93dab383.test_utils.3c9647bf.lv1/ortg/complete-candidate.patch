+def _is_valid_uri(uri: str):
+    """Return whether ``uri`` has the structure required for a gateway URI."""
+    if uri == "databricks":
+        return True
 
+    try:
+        parsed = urlparse(uri)
+        return bool(parsed.scheme and (parsed.netloc or parsed.scheme == "databricks"))
+    except (AttributeError, TypeError, ValueError):
+        return False
 
 
+def assemble_uri_path(paths: list[str]) -> str:
+    """Join URI path components with exactly one leading slash."""
+    parts = [stripped for path in paths if path if (stripped := path.strip("/"))]
+    return f"/{posixpath.join(*parts)}" if parts else "/"
 
 
+def check_configuration_route_name_collisions(config):
+    """Validate endpoint and traffic-route references in a gateway configuration."""
+    endpoints = config.get("endpoints") or []
+    routes = config.get("routes") or []
 
+    endpoint_names = [endpoint["name"] for endpoint in endpoints]
+    route_names = [route["name"] for route in routes]
+    all_names = endpoint_names + route_names
+    if len(all_names) != len(set(all_names)):
+        raise MlflowException.invalid_parameter_value(
+            "Duplicate names found in endpoint / route configurations."
+        )
 
+    endpoint_types = {endpoint["name"]: endpoint["endpoint_type"] for endpoint in endpoints}
+    for route in routes:
+        route_name = route["name"]
+        task_type = route["task_type"]
+        total_traffic = 0
+        for destination in route.get("destinations") or []:
+            endpoint_name = destination["name"]
+            if endpoint_name not in endpoint_types:
+                raise MlflowException.invalid_parameter_value(
+                    f"Route '{route_name}' references endpoint '{endpoint_name}', which is not "
+                    "defined in the gateway configuration."
+                )
+            if endpoint_types[endpoint_name] != task_type:
+                raise MlflowException.invalid_parameter_value(
+                    f"Route '{route_name}' has task type '{task_type}', but destination "
+                    f"endpoint '{endpoint_name}' has endpoint type "
+                    f"'{endpoint_types[endpoint_name]}'."
+                )
+
+            traffic_percentage = destination["traffic_percentage"]
+            if (
+                not isinstance(traffic_percentage, (int, float))
+                or not 0 <= traffic_percentage <= 100
+            ):
+                raise MlflowException.invalid_parameter_value(
+                    f"Traffic percentage for endpoint '{endpoint_name}' in route "
+                    f"'{route_name}' must be between 0 and 100."
+                )
+            total_traffic += traffic_percentage
+
+        if total_traffic != 100:
+            raise MlflowException.invalid_parameter_value(
+                f"Traffic percentages for route '{route_name}' must sum to 100."
+            )
 
 
+def is_valid_endpoint_name(name: str) -> bool:
+    """Return whether an endpoint name is safe for use in a URL path."""
+    return bool(name and re.fullmatch(r"[\w.-]+", name))
 
 
