+def _parse_formats(*cosmos: object, format: _FormatsType) -> ndarray:
+    """Parse each cosmology-like argument with its corresponding format hint.
+
+    A scalar format is repeated for every positional argument.  A non-scalar
+    format must broadcast to exactly that argument axis; it never contributes
+    dimensions to any vectorized cosmology argument.
+    """
+    nargs = len(cosmos)
+    formats = np.broadcast_to(np.asarray(format, dtype=object), (nargs,))
+    if not nargs:
+        return np.empty(0, dtype=object)
+
+    # Determine the element-wise shape solely from the cosmology arguments.
+    # Table and Row deliberately masquerade as scalars here: NumPy otherwise
+    # expands their rows or columns while constructing an object array.
+    wrapped = [
+        _CosmologyWrapper(cosmo)
+        if isinstance(cosmo, _CANT_BROADCAST)
+        else cosmo
+        for cosmo in cosmos
+    ]
+    arrays = [np.asarray(cosmo, dtype=object) for cosmo in wrapped]
+    broadcast = np.broadcast_arrays(*arrays)
+    cosmology_array = np.stack(broadcast)
+
+    # Each hint belongs to one positional argument.  Add singleton element
+    # axes only after the cosmology shape has been fixed, then broadcast over
+    # those axes.
+    element_ndim = cosmology_array.ndim - 1
+    formats = formats.reshape((nargs,) + (1,) * element_ndim)
+    formats = np.broadcast_to(formats, cosmology_array.shape)
+    return _parse_format(cosmology_array, formats)
+
+
+def _is_equivalent_scalar(cosmo1: Cosmology, cosmo2: Cosmology, /) -> bool:
+    """Apply the asymmetric ``__equiv__`` protocol in both directions."""
+    equivalent = cosmo1.__equiv__(cosmo2)
+    if equivalent is NotImplemented:
+        equivalent = cosmo2.__equiv__(cosmo1)
+    return False if equivalent is NotImplemented else bool(equivalent)
+
+
+_is_equivalent = np.frompyfunc(_is_equivalent_scalar, 2, 1)
+
+
 
 
 
