+def inspect_main(argv: list[str], /) -> int:
+    """Print the contents of an intersphinx inventory."""
+    if not argv:
+        print('Usage: python -m sphinx.ext.intersphinx <inventory>', file=sys.stderr)
+        return 1
+
+    location = argv[0]
+    parsed = urlsplit(location)
+    target_uri = (
+        posixpath.dirname(location) if parsed.scheme in {'http', 'https'} else ''
+    )
+    config = _InvConfig(
+        intersphinx_cache_limit=0,
+        intersphinx_timeout=None,
+        tls_verify=True,
+        tls_cacerts=None,
+        user_agent='',
+    )
+    try:
+        raw_data, target_uri = _fetch_inventory_data(
+            target_uri=target_uri,
+            inv_location=location,
+            config=config,
+            srcdir=Path.cwd(),
+            cache_path=None,
+        )
+        inventory = _load_inventory(raw_data, target_uri=target_uri).data
+    except ValueError as exc:
+        print(f'Inventory error: {exc}', file=sys.stderr)
+        return 1
+    except Exception as exc:
+        print(f'Unable to load inventory {location!r}: {exc}', file=sys.stderr)
+        return 1
+
+    for objtype in sorted(inventory):
+        print(objtype)
