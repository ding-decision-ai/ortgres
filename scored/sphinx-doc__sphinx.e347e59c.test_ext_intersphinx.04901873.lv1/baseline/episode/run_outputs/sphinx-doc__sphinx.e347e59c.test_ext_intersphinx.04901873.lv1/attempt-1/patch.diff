+def _object_types_for_reference(
+    env: BuildEnvironment, node: pending_xref, inventory: Inventory
+) -> list[str]:
+    domain_name = node.get('refdomain')
+    role_name = node.get('reftype')
+    if role_name == 'any':
+        return sorted(inventory)
+    if not domain_name or domain_name not in env.domains:
+        return []
+    domain = env.domains[domain_name]
+    objtypes = list(domain.objtypes_for_role(role_name) or ())
+    if domain_name == 'py':
+        if role_name == 'class':
+            objtypes.extend(('data', 'attribute'))
+        elif role_name == 'attr':
+            objtypes.extend(('method', 'property'))
+        elif role_name == 'meth':
+            objtypes.extend(('property', 'attribute'))
+    return list(dict.fromkeys(f'{domain_name}:{objtype}' for objtype in objtypes))
+
+
+def _target_candidates(node: pending_xref, objtype: str) -> list[str]:
+    target = node['reftarget']
+    candidates = [target]
+    if objtype in {'std:label', 'std:term'}:
+        candidates.append(target.lower())
+    elif objtype == 'std:doc':
+        if target.startswith('/'):
+            candidates.append(target.lstrip('/'))
+        elif refdoc := node.get('refdoc'):
+            candidates.append(
+                posixpath.normpath(posixpath.join(posixpath.dirname(refdoc), target))
+            )
+    elif objtype == 'std:cmdoption':
+        candidates.extend((target.replace(' ', '.'), target.replace(' ', '-')))
+
+    if objtype.startswith('py:'):
+        module_name = node.get('py:module')
+        class_name = node.get('py:class')
+        if class_name:
+            if module_name and not class_name.startswith(f'{module_name}.'):
+                candidates.append(f'{module_name}.{class_name}.{target}')
+            candidates.append(f'{class_name}.{target}')
+        if module_name:
+            candidates.append(f'{module_name}.{target}')
+    elif objtype.startswith('js:'):
+        module_name = node.get('js:module')
+        class_name = node.get('js:class')
+        if class_name:
+            candidates.append(f'{class_name}.{target}')
+        if module_name:
+            candidates.append(f'{module_name}.{target}')
+    return list(dict.fromkeys(candidate for candidate in candidates if candidate))
