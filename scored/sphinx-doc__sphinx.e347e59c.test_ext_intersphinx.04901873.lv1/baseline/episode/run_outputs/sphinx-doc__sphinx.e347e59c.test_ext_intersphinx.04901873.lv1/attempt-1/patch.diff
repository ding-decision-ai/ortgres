+    refspecific: bool,
+) -> tuple[str, _InventoryItem] | None:
+    for candidate in candidates:
+        if candidate in objects:
+            return candidate, objects[candidate]
+
+    folded_candidates = {candidate.casefold() for candidate in candidates}
+    folded_matches = [
+        (name, item)
+        for name, item in objects.items()
+        if name.casefold() in folded_candidates
+    ]
+    if len(folded_matches) == 1:
+        return folded_matches[0]
+
+    if refspecific:
+        suffixes = tuple(f'.{candidate}' for candidate in candidates)
+        matches = [
+            (name, item) for name, item in objects.items() if name.endswith(suffixes)
+        ]
+        if len(matches) == 1:
+            return matches[0]
