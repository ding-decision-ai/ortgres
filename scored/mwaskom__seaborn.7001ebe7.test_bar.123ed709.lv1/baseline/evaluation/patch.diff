+                isinstance(self.edgewidth, Mappable)
+                and self.edgewidth._auto
+                and "edgewidth" not in data
+            )
+            if is_auto:
+                auto_width[ax].extend([
+                    bar._seaborn_fill
+                    for bar in bars
+                ])
+            else:
+                auto_width[ax].extend([None] * len(bars))
+
+        for ax, ax_patches in patches.items():
+
+            collection = mpl.collections.PatchCollection(
+                ax_patches, match_original=True, **self.artist_kws,
+            )
+            collection.sticky_edges[val_idx][:] = (0, np.inf)
+
+            # Keep limit handling explicit so collections participate in
+            # autoscaling consistently across matplotlib versions.
+            if ax_patches:
+                vertices = np.concatenate([
+                    patch.get_path().transformed(patch.get_transform()).vertices
+                    for patch in ax_patches
+                ])
+                ax.update_datalim(vertices)
+            ax.add_collection(collection, autolim=False)
+
+            if any(flag is not None for flag in auto_width[ax]):
+                # Automatic edges are proportional to the rendered bar width,
+                # capped by the patch rc default. Outlined bars retain a visible
+                # minimum in dense histograms.
+                ax.autoscale_view()
