+                    display_vertices = ax.transData.transform(vertices)
+                    pos_idx = ["x", "y"].index(orient)
+                    pixels = np.ptp(display_vertices[:, pos_idx])
+                    width_points = pixels * 72 / ax.figure.dpi
+                    max_width = mpl.rcParams["patch.linewidth"]
+                    if not filled:
