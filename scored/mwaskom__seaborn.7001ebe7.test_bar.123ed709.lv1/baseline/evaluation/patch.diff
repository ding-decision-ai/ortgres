+    def _make_patches(self, data, scales, orient):
+
+        other = {"x": "y", "y": "x"}[orient]
+
+        # Widths are computed in transformed coordinates before the data are
+        # converted back to native axis units. Invert each edge separately so
+        # bars retain the intended width on nonlinear position scales.
+        transform = scales[orient]._matplotlib_scale.get_transform()
+        forward = transform.transform
+        inverse = transform.inverted().transform
+        center = forward(data[orient].to_numpy())
+        half_width = data["width"].to_numpy() / 2
+        start = inverse(center - half_width)
+        stop = inverse(center + half_width)
+
+        # Moves also operate before coordinate inversion, so baselines remain in
+        # transformed coordinates while the value column is in native units.
+        val_transform = scales[other]._matplotlib_scale.get_transform()
+        baseline = val_transform.inverted().transform(data["baseline"].to_numpy())
+        value = data[other].to_numpy() - baseline
+
+        if orient == "x":
+            x, y = start, baseline
+            width, height = stop - start, value
+        else:
+            x, y = baseline, start
+            width, height = value, stop - start
+
+        resolved = resolve_properties(self, data, scales)
+        facecolor = resolve_color(self, data, "", scales)
+        edgecolor = resolve_color(self, data, "edge", scales)
+        if np.ndim(facecolor) == 1:
+            facecolor = np.tile(facecolor, (len(data), 1))
+        if np.ndim(edgecolor) == 1:
+            edgecolor = np.tile(edgecolor, (len(data), 1))
+
+        bars = []
+        vals = []
+        for i in range(len(data)):
+            # Degenerate and non-finite value spans can interfere with collection
+            # limits and have no visible representation.
+            if not np.isfinite(value[i]) or value[i] == 0:
+                continue
+
+            fc = facecolor[i]
+            if not resolved["fill"][i]:
+                fc = mpl.colors.to_rgba(fc, 0)
+
+            bar = mpl.patches.Rectangle(
+                (x[i], y[i]), width[i], height[i],
+                facecolor=fc,
+                edgecolor=edgecolor[i],
+                linewidth=resolved["edgewidth"][i],
+                linestyle=resolved["edgestyle"][i],
+                **self.artist_kws,
+            )
+            bar._seaborn_fill = bool(resolved["fill"][i])
+            bars.append(bar)
+            vals.append(value[i])
+
+        return bars, np.asarray(vals)
+
+    def _legend_artist(
+        self, variables: list[str], value: Any, scales: dict[str, Scale],
+    ) -> Artist:
+        """Create a legend patch with the bar mark's resolved properties."""
+
+        keys = {v: value for v in variables}
+        resolved = resolve_properties(self, keys, scales)
+
+        facecolor = resolve_color(self, keys, "", scales)
+        if not resolved["fill"]:
+            facecolor = mpl.colors.to_rgba(facecolor, 0)
+
+        return mpl.patches.Patch(
+            facecolor=facecolor,
+            edgecolor=resolve_color(self, keys, "edge", scales),
+            linewidth=resolved["edgewidth"],
+            linestyle=resolved["edgestyle"],
+            **self.artist_kws,
+        )
 
 
 
