+    def _make_patches(self, data, scales, orient):
+
+        other = {"x": "y", "y": "x"}[orient]
+        transform = scales[orient]._matplotlib_scale.get_transform()
+        forward = transform.transform
+        inverse = transform.inverted().transform
+
+        center = np.asarray(data[orient], float)
+        half_width = np.asarray(data["width"], float) / 2
+        start = inverse(forward(center) - half_width)
+        width = inverse(forward(center) + half_width) - start
+        baseline = np.asarray(data["baseline"], float)
+        value = np.asarray(data[other], float) - baseline
+
+        resolved = resolve_properties(self, data, scales)
+        facecolor = np.array(resolve_color(self, data, scales=scales), copy=True)
+        edgecolor = resolve_color(self, data, prefix="edge", scales=scales)
+        facecolor[~np.asarray(resolved["fill"], bool), 3] = 0
+
+        patches = []
+        values = []
+        for i, val in enumerate(value):
+            if not np.isfinite(val) or val == 0:
+                continue
+
+            if orient == "x":
+                xy = start[i], baseline[i]
+                w, h = width[i], val
+            else:
+                xy = baseline[i], start[i]
+                w, h = val, width[i]
+
+            patch = mpl.patches.Rectangle(
+                xy, w, h,
+                facecolor=facecolor[i],
+                edgecolor=edgecolor[i],
+                linewidth=resolved["edgewidth"][i],
+                linestyle=resolved["edgestyle"][i],
+                **self.artist_kws,
+            )
+            patches.append(patch)
+            values.append(val)
+
+        return patches, np.asarray(values)
