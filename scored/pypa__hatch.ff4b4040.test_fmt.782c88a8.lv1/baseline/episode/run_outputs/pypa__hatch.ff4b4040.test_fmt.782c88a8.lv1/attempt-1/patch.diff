+    def run_shell_commands(self, context: ExecutionContext) -> None:
+        first_error = 0
+        show_commands = not context.hide_commands and (self.verbose or len(context.shell_commands) > 1)
+
+        with context.env.command_context():
+            for index, raw_command in enumerate(context.shell_commands, 1):
+                command = raw_command
+                ignore_error = False
+                if command.startswith("- "):
+                    ignore_error = True
+                    command = command[2:]
+
+                if show_commands:
+                    prefix = f"{context.source} [{index}]" if len(context.shell_commands) > 1 else context.source
+                    # Display the original form so ignored commands remain
+                    # distinguishable in command traces.
+                    self.display_info(f"{prefix} | {raw_command}")
+
+                try:
+                    return_code = context.env.run_shell_command(command)
+                except OSError as e:
+                    self.abort(str(e))
+                    return
+                finally:
+                    sys.stdout.flush()
+                    sys.stderr.flush()
+
+                if not return_code:
+                    continue
+
+                if ignore_error:
+                    continue
+
+                if not first_error:
+                    first_error = return_code
+
+                if not context.force_continue:
+                    message = f"Command failed with exit code {return_code}" if context.show_code_on_error else ""
+                    self.abort(message, code=return_code)
+                    return
+
+        if first_error:
+            self.abort(code=first_error)
+
 
 
 
