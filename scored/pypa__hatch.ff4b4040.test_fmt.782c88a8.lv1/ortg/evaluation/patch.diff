+        except Exception as e:  # noqa: BLE001
+            self.abort(str(e))
+            return
+
+        show_commands = not context.hide_commands and (self.verbose or len(commands) > 1)
+        first_error = 0
+        for index, command in enumerate(commands, 1):
+            ignore_error = command.startswith("- ")
+            if show_commands:
+                prefix = f"{context.source} [{index}]" if len(commands) > 1 else context.source
+                self.display_info(f"{prefix} | {command}")
+
+            process = context.env.run_shell_command(command[2:] if ignore_error else command)
+            sys.stdout.flush()
+            sys.stderr.flush()
+            if not process.returncode or ignore_error:
+                continue
+
+            if context.force_continue:
+                if not first_error:
+                    first_error = process.returncode
+                continue
+
+            if context.show_code_on_error:
+                self.abort(f"Failed with exit code: {process.returncode}", code=process.returncode)
+            else:
+                self.abort(code=process.returncode)
+            return
+
+        if first_error:
+            self.abort(code=first_error)
+
 
 
 
