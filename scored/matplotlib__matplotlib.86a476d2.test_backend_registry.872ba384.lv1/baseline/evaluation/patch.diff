+    def _read_entry_points(self):
+        """Return ``(name, module)`` pairs advertised as backend entry points."""
+        import importlib.metadata as im
+
+        return [(entry.name, entry.value)
+                for entry in im.entry_points(group="matplotlib.backend")]
+
+    def _validate_and_store_entry_points(self, entries):
+        """Validate and store entry points for later backend resolution."""
+        # Collapse only exact duplicates.  In particular, entries which differ
+        # merely in the case of their name are conflicting entries, rather than
+        # duplicates, because backend names are case-insensitive.
+        entries = list(dict.fromkeys(entries))
+        normalized = [(name.lower(), module) for name, module in entries]
+
+        for name, _ in normalized:
+            if name.startswith("module://"):
+                raise RuntimeError(
+                    f"Entry point name {name!r} cannot start with 'module://'")
+            if name in self._BUILTIN_BACKEND_TO_GUI_FRAMEWORK:
+                raise RuntimeError(
+                    f"Entry point name {name!r} is a built-in backend")
+
+        names = [name for name, _ in normalized]
+        if len(names) != len(set(names)):
+            raise RuntimeError("Entry point backend name is duplicated")
+
+        # Do not partly update the registry if validation above fails.
+        for name, module in normalized:
+            self._name_to_module[name] = module
+            self._backend_to_gui_framework[name] = "unknown"
+
+    def backend_for_gui_framework(self, framework):
+        """Return the preferred built-in backend for *framework*, if any."""
+        return self._GUI_FRAMEWORK_TO_BACKEND.get(framework.lower())
+
+    def list_all(self):
+        """Return all built-in and dynamically registered backend names."""
+        self._ensure_entry_points_loaded()
+        return [*self._BUILTIN_BACKEND_TO_GUI_FRAMEWORK,
+                *self._backend_to_gui_framework]
+
+    def list_builtin(self, filter_=None):
