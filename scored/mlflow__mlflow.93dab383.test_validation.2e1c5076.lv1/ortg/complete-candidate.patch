 IS_DBX_AGENTS_INSTALLED = importlib.util.find_spec("databricks.agents") is not None
 
 
+def valid_data_for_builtin_scorers(
+    data: "pd.DataFrame",
+    builtin_scorers: list[BuiltInScorer],
+    predict_fn: Callable[..., Any] | None = None,
+) -> None:
+    """Validate columns used by built-in scorers without aborting on missing columns."""
+    legacy_column_mapping = {"request": "inputs", "response": "outputs"}
+    available_columns = {legacy_column_mapping.get(column, column) for column in data.columns}
+
+    if predict_fn is not None:
+        available_columns.update({"outputs", "trace"})
+
+    # Inputs and outputs can be recovered from an evaluation trace. Expectations are
+    # deliberately handled below because their individual names are part of the schema.
+    if "trace" in available_columns:
+        available_columns.update({"inputs", "outputs"})
+
+    if "expectations" in data.columns:
+        for row_index, expectations in data["expectations"].items():
+            if expectations is None or expectations is pd.NA:
+                continue
+            if isinstance(expectations, float) and pd.isna(expectations):
+                continue
+            if not isinstance(expectations, dict):
+                raise MlflowException.invalid_parameter_value(
+                    "The `expectations` column must contain dictionaries mapping expectation "
+                    f"names to values. Got {type(expectations).__name__} at row {row_index}."
+                )
+            available_columns.update(f"expectations/{key}" for key in expectations)
+
+    missing_columns_to_scorers: dict[str, list[str]] = defaultdict(list)
+    for builtin_scorer in builtin_scorers:
+        try:
+            builtin_scorer.validate_columns(available_columns)
+        except MissingColumnsException as e:
+            for missing_column in e.missing_columns:
+                missing_columns_to_scorers[str(missing_column)].append(e.scorer)
+
+    if missing_columns_to_scorers:
+        diagnostics = "\n".join(
+            f"  - {column}: required by {', '.join(scorer_names)}"
+            for column, scorer_names in sorted(missing_columns_to_scorers.items())
+        )
+        _logger.warning(
+            "Some built-in scorers are missing required columns and will return null results "
+            "for affected rows:\n%s",
+            diagnostics,
+        )
+
+
+def _get_legacy_metric_type() -> type | None:
+    if not IS_DBX_AGENTS_INSTALLED:
+        return None
+
+    try:
+        from databricks.rag_eval.evaluation.metrics import Metric
+
+        return Metric
+    except ImportError:
+        return None
+
+
+def validate_scorers(scorers: list[Any]) -> list[Scorer]:
+    """Validate and return scorer instances accepted by GenAI evaluation."""
+    if not isinstance(scorers, list):
+        raise MlflowException.invalid_parameter_value(
+            f"`scorers` must be a list of Scorer instances. Got {type(scorers).__name__}."
+        )
+
+    legacy_metric_type = _get_legacy_metric_type()
+    validated_scorers = []
+    for index, candidate in enumerate(scorers):
+        if isinstance(candidate, Scorer):
+            validate_aggregations(candidate.aggregations)
+            validated_scorers.append(candidate)
+            continue
+
+        if legacy_metric_type is not None and isinstance(candidate, legacy_metric_type):
+            _logger.warning(
+                "Passing legacy databricks.rag_eval Metric objects as scorers is deprecated. "
+                "Use mlflow.genai.scorers.Scorer or the @scorer decorator instead."
+            )
+            validated_scorers.append(candidate)
+            continue
+
+        if isinstance(candidate, list):
+            hint = (
+                " Scorer lists must not be nested. If you used `[get_all_scorers()]`, pass "
+                "`get_all_scorers()` directly instead."
+            )
+        elif inspect.isclass(candidate) and issubclass(candidate, Scorer):
+            hint = (
+                f" `{candidate.__name__}` is a scorer class; instantiate it as "
+                f"`{candidate.__name__}()`."
+            )
+        else:
+            hint = " Pass Scorer instances or functions decorated with `@scorer`."
+
+        raise MlflowException.invalid_parameter_value(
+            f"Invalid scorer at index {index}: expected a Scorer instance, got "
+            f"{type(candidate).__name__}.{hint}"
+        )
+
+    return validated_scorers
+
+
 
 
 
