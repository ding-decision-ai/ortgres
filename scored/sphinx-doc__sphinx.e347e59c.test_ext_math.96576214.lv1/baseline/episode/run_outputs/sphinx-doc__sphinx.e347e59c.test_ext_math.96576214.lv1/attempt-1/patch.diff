--- a/sphinx/builders/latex/transforms.py
+++ b/sphinx/builders/latex/transforms.py
@@ -633,6 +633,17 @@ class IndexInSectionTitleTransform(SphinxPostTransform):
     default_priority = 400
     formats = ('latex',)
 
+    def run(self, **kwargs: Any) -> None:
+        for title in self.document.findall(nodes.title):
+            section = title.parent
+            if not isinstance(section, nodes.section):
+                continue
+
+            insert_at = section.index(title) + 1
+            for index in list(title.findall(addnodes.index)):
+                index.parent.remove(index)
+                section.insert(insert_at, index)
+                insert_at += 1
 
 
 
