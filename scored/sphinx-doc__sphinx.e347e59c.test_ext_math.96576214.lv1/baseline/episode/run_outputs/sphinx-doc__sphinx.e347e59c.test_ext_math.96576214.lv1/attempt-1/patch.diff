--- a/sphinx/builders/singlehtml.py
+++ b/sphinx/builders/singlehtml.py
@@ -39,6 +39,17 @@ class SingleFileHTMLBuilder(StandaloneHTMLBuilder):
     def get_outdated_docs(self) -> str | list[str]:  # type: ignore[override]
         return 'all documents'
 
+    def get_relative_uri(self, from_: str, to: str, typ: str | None = None) -> str:
+        # All source documents are written to the same output page, so the
+        # source document has no bearing on the resulting URI.
+        return self.get_target_uri(to, typ)
+
+    def get_target_uri(self, docname: str, typ: str | None = None) -> str:
+        if docname in self.env.all_docs:
+            return '#document-' + docname
+
+        # Additional pages are not part of the combined document.
+        return docname + self.out_suffix
 
 
 
