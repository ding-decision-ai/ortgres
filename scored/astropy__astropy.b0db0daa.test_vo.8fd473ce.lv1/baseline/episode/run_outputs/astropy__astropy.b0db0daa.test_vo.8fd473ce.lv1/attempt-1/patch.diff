+def check_token(token):
+    """Return whether *token* is in XML Schema ``token`` canonical form."""
+    if not isinstance(token, str):
+        return False
+    return (
+        token == token.strip(" \r\n\t")
+        and "\r" not in token
+        and "\n" not in token
+        and "\t" not in token
+    )
+
+
+def check_anyuri(uri):
+    """Return whether *uri* is syntactically usable as an XML anyURI."""
+    if not isinstance(uri, str) or any(char.isspace() for char in uri):
+        return False
+    if re.search(r"%(?![0-9A-Fa-f]{2})", uri):
+        return False
+    try:
+        urllib.parse.urlsplit(uri)
+    except ValueError:
+        return False
+    return True
