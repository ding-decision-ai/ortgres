+    @classmethod
+    def _validate_unit(
+        cls, s: str, deprecations: DeprecatedUnitAction = DeprecatedUnitAction.WARN
+    ) -> UnitBase:
+        """Look up a unit name supported by this formatter."""
+        action = DeprecatedUnitAction(deprecations)
+        unit = cls._units[s]
+        if s in getattr(cls, "_deprecated_units", ()):
+            message = f"The unit {s!r} has been deprecated in the {cls.name} standard."
+            if action is DeprecatedUnitAction.RAISE:
+                raise UnitsError(message)
+            if action is DeprecatedUnitAction.WARN:
+                warnings.warn(message, UnitsWarning)
+        return unit
+
+    @classmethod
+    def _decompose_to_known_units(
+        cls,
+        unit: UnitBase,
+        deprecations: DeprecatedUnitAction = DeprecatedUnitAction.WARN,
+    ) -> UnitBase:
+        """Decompose *unit* until all bases are known to this formatter."""
+        action = DeprecatedUnitAction(deprecations)
+
+        if isinstance(unit, CompositeUnit):
+            scale = unit.scale
+            bases = []
+            powers = []
+            for base, power in zip(unit.bases, unit.powers, strict=True):
+                known = cls._decompose_to_known_units(base, action)
+                scale *= known.scale**power
+                bases.extend(known.bases)
+                powers.extend(known_power * power for known_power in known.powers)
+            return CompositeUnit(scale, bases, powers)
+
+        if isinstance(unit, NamedUnit):
+            name = unit._get_format_name(cls.name)
+            if name in cls._units:
+                cls._validate_unit(name, action)
+                return unit
+            represented = getattr(unit, "_represents", unit)
+            if represented is not unit:
+                return cls._decompose_to_known_units(represented, action)
+
+        raise ValueError(f"Unit {unit!r} is not supported by the {cls.name} standard")
+
 
