+def _format_message(message, warning, config=None, pos=None):
+    """Add source position and warning code to a VOTable message."""
+    if config is None:
+        config = {}
+    filename = config.get("filename")
+    if pos is None:
+        line, column = "?", "?"
+    else:
+        line, column = pos
+    location = f"{line}:{column}"
+    if filename:
+        location = f"{filename}:{location}"
+    return f"{location}: {warning}: {message}"
+
+
+def _suppressed_warning(warning, config=None, stacklevel=1):
+    """Emit repeated warnings up to the configured per-type limit."""
+    if config is None:
+        config = {}
+    counts = config.setdefault("_warning_counts", {})
+    warning_type = type(warning)
+    count = counts.get(warning_type, 0) + 1
+    counts[warning_type] = count
+
+    if count > conf.max_warnings:
+        return
+    if count == conf.max_warnings:
+        warning.formatted_message += (
+            " (suppressing further warnings of this type...)"
+        )
+        warning.args = (warning.formatted_message,)
+    warn(warning, stacklevel=stacklevel + 1)
+
