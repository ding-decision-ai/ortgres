+@contextlib.contextmanager
+def _convert_to_fd_or_read_function(source):
+    """Normalize XML input to a binary file object or read callable."""
+    if callable(source):
+        yield source
+        return
+
+    # Expat consumes bytes.  Adapt text streams without taking ownership of
+    # the caller's object; ordinary binary file objects can be passed through.
+    if hasattr(source, "read"):
+        try:
+            sample = source.read(0)
+        except TypeError:
+            sample = b""
+        if isinstance(sample, str):
+            encoding = getattr(source, "encoding", None) or "utf-8"
+
+            def read(size=-1):
+                return source.read(size).encode(encoding)
+
+            yield read
+        else:
+            yield source.read
+        return
+
+    with data.get_readable_fileobj(source, encoding="binary") as fd:
+        yield fd
+
 
 
 
