diff --git a/astropy/utils/xml/validate.py b/astropy/utils/xml/validate.py
index 7b4faf3..556021a 100644
--- a/astropy/utils/xml/validate.py
+++ b/astropy/utils/xml/validate.py
@@ -12,3 +12,16 @@ import subprocess
 from signal import Signals
 
 
+def validate_schema(filename, schema):
+    """Validate an XML document against an XML Schema or DTD with xmllint."""
+    option = "--dtdvalid" if str(schema).lower().endswith(".dtd") else "--schema"
+    process = subprocess.Popen(
+        ["xmllint", "--noout", option, os.fspath(schema), os.fspath(filename)],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+    )
+    stdout, stderr = process.communicate()
+    returncode = process.returncode
+    if returncode < 0:
+        stderr += f"xmllint terminated by {Signals(-returncode).name}\n".encode()
+    return returncode, stdout, stderr
