 import urllib.parse
 
 
+_id_start = re.compile(r"[A-Za-z_]")
+_id_char = re.compile(r"[A-Za-z0-9_.-]")
+
+
+def check_id(value):
+    """Return whether *value* is a syntactically valid XML ID."""
+    if not isinstance(value, str) or not value:
+        return False
+    return _id_start.fullmatch(value[0]) is not None and all(
+        _id_char.fullmatch(char) is not None for char in value[1:]
+    )
+
+
+def fix_id(value):
+    """Return *value* with characters invalid in an XML ID replaced."""
+    if not isinstance(value, str):
+        value = str(value)
+    if not value or _id_start.fullmatch(value[0]) is None:
+        value = "_" + value
+    return "".join(
+        char if _id_char.fullmatch(char) is not None else "_" for char in value
+    )
+
+
 
 
 
