+def validate_schema(filename, schema):
+    """Validate an XML file against an XSD schema or DTD using xmllint."""
+    extension = os.path.splitext(os.fspath(schema))[1].lower()
+    if extension == ".dtd":
+        schema_option = "--dtdvalid"
+    else:
+        schema_option = "--schema"
+
+    process = subprocess.Popen(
+        ["xmllint", "--noout", schema_option, os.fspath(schema), os.fspath(filename)],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+    )
+    stdout, stderr = process.communicate()
