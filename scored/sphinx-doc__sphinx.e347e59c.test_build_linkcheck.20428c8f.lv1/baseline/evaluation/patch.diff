+    def limit_rate(self, response_url: str, retry_after: str | None) -> float | None:
+        """Schedule another check after a response has been rate limited."""
+        netloc = urlsplit(response_url).netloc
+        now = time.time()
+
+        delay: float | None = None
+        next_check: float | None = None
+        if retry_after is not None:
+            try:
+                delay = float(retry_after)
+            except (TypeError, ValueError):
+                try:
+                    next_check = parsedate_to_datetime(retry_after).timestamp()
+                except (TypeError, ValueError, OverflowError, OSError):
+                    pass
+                else:
+                    delay = next_check - now
+            else:
+                next_check = now + delay
+
+        if delay is None or next_check is None:
+            previous = self.rate_limits.get(netloc)
+            if previous is None:
+                delay = DEFAULT_DELAY
+            else:
+                delay = previous.delay * 2
+                if previous.delay < self.rate_limit_timeout < delay:
+                    delay = float(self.rate_limit_timeout)
+                elif delay > self.rate_limit_timeout:
+                    return None
+            next_check = now + delay
+
+        self.rate_limits[netloc] = RateLimit(delay, next_check)
+        return next_check
+
 
 
 
