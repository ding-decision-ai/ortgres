diff --git a/sphinx/ext/napoleon/docstring.py b/sphinx/ext/napoleon/docstring.py
index efa1736..9f10ef1 100644
--- a/sphinx/ext/napoleon/docstring.py
+++ b/sphinx/ext/napoleon/docstring.py
@@ -152,63 +152,41 @@ def postprocess(item: str) -> list[str]:
     return tokens
 
 
+def _token_type(token: str, debug_location: str | None = None) -> str:
+    """Classify one token from a Napoleon type specification."""
+    if token.isnumeric():
+        type_ = 'literal'
+    elif token in ('optional', 'default'):
+        type_ = 'control'
+    elif token.startswith('{'):
+        type_ = 'literal'
+        if not token.endswith('}'):
+            logger.warning(
+                __('invalid value set (missing closing brace): %s'),
+                token,
+                location=debug_location,
+            )
+    elif token[0:1] in {'"', "'"}:
+        type_ = 'literal'
+        if not token.endswith(token[0]):
+            logger.warning(
+                __('invalid string literal (missing closing quote): %s'),
+                token,
+                location=debug_location,
+            )
+    elif token[:1].isspace() or token[-1:].isspace():
+        type_ = 'delimiter'
+    elif _xref_regex.match(token):
+        type_ = 'reference'
+    else:
+        try:
+            complex(token)
+        except ValueError:
+            type_ = 'obj'
+        else:
+            type_ = 'literal'
 
