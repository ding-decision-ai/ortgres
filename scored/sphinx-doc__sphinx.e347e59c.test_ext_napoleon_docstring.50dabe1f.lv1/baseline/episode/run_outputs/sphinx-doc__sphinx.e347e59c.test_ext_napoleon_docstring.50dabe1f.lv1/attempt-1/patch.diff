+def load_mappings(app: Sphinx) -> None:
+    """Load all configured intersphinx inventories into the environment."""
+    mapping: IntersphinxMapping = app.config.intersphinx_mapping
+    projects: list[_IntersphinxProject] = []
+
+    # The mapping has already been normalised by
+    # ``validate_intersphinx_mapping``.  Failure here therefore indicates an
+    # internal error (or a caller invoking this hook out of order), rather
+    # than a configuration form that this function should try to normalise.
+    for value in mapping.values():
+        try:
+            name, (target_uri, locations) = value
+            project = _IntersphinxProject(
+                name=name,
+                target_uri=target_uri,
+                locations=locations,
+            )
+        except (TypeError, ValueError) as exc:
+            msg = __(
+                'Invalid intersphinx_mapping entry after normalisation: %r'
+            )
+            raise ConfigError(msg % (value,)) from exc
+        projects.append(project)
+
+    inventories = InventoryAdapter(app.env)
+    cache = inventories.cache
+
+    # A cached inventory is useful only while its target URI is configured.
+    configured_uris = {project.target_uri for project in projects}
+    for uri in cache.keys() - configured_uris:
+        del cache[uri]
+
+    now = int(time.time())
+    config = _InvConfig.from_config(app.config)
+    cache_dir = app.doctreedir / '__intersphinx_cache__'
+
+    with concurrent.futures.ThreadPoolExecutor() as executor:
+        futures = [
+            executor.submit(
+                _fetch_inventory_group,
+                project=project,
+                cache=cache,
+                now=now,
+                config=config,
+                srcdir=app.srcdir,
+                cache_dir=cache_dir,
+            )
+            for project in projects
+        ]
+        updated = any(future.result() for future in futures)
 
+    # Keep the existing views when every fetch was satisfied by the cache.
+    if not updated:
+        return
 
