index 353e293..10b8f0b 100644
--- a/mesonbuild/cargo/toml.py
+++ b/mesonbuild/cargo/toml.py
@@ -31,3 +31,27 @@ class TomlImplementationMissing(MesonException):
     pass
 
 
+def load_toml(filename: str) -> T.Dict[str, object]:
+    """Load *filename* using the available TOML implementation."""
+    if tomllib is not None:
+        # tomllib (and tomli's compatible API) requires a binary file object so
+        # that it can apply TOML's mandated UTF-8 decoding itself.
+        with open(filename, 'rb') as f:
+            return T.cast('T.Dict[str, object]', tomllib.load(f))
+
+    if toml2json is None:
+        raise TomlImplementationMissing(
+            'No TOML parser is available. Use Python 3.11+, install tomli, or install toml2json.')
+
+    process, stdout, stderr = Popen_safe([toml2json, filename])
+    if process.returncode != 0:
+        detail = stderr.strip() or stdout.strip()
+        raise MesonException(f'Failed to parse TOML file {filename}: {detail}')
+    try:
+        parsed = json.loads(stdout)
+    except json.JSONDecodeError as e:
+        raise MesonException(f'Failed to decode toml2json output for {filename}: {e}') from e
+    if not isinstance(parsed, dict):
+        raise MesonException(f'TOML file {filename} did not contain a top-level table')
+    return T.cast('T.Dict[str, object]', parsed)
+
diff --git a/mesonbuild/cargo/version.py b/mesonbuild/cargo/version.py
index 1f8127b..c62b37d 100644
--- a/mesonbuild/cargo/version.py
+++ b/mesonbuild/cargo/version.py
@@ -7,3 +7,86 @@ from __future__ import annotations
 import typing as T
 
 
+def api(version: str) -> str:
+    """Return the Cargo API compatibility component of *version*.
+
+    Cargo follows semver for releases starting at 1.0.  Before 1.0 the minor
+    component is the compatibility boundary (with all 0.0 releases sharing
+    the ``0`` API used by Meson's Cargo dependency naming convention).
+    """
+    components = version.split('.')
+    major = components[0]
+    if major != '0':
+        return major
+    if len(components) > 1 and components[1] != '0':
+        return f'0.{components[1]}'
+    return '0'
+
+
+def _release_components(requirement: str) -> T.List[int]:
+    """Get the numeric release components used to calculate an upper bound."""
+    # Pre-release/build information affects the lower bound, but never which
+    # release component Cargo increments for the compatibility upper bound.
+    release = requirement.split('+', 1)[0].split('-', 1)[0]
+    return [int(component) for component in release.split('.')]
+
+
+def _upper_bound(components: T.List[int], index: int) -> str:
+    upper = components[:index + 1]
+    upper[index] += 1
+    return '.'.join(str(component) for component in upper)
+
+
+def _range(lower: str, upper: str) -> T.List[str]:
+    return [f'>= {lower}', f'< {upper}']
+
+
+def convert(cargo_ver: str) -> T.List[str]:
+    """Convert Cargo version requirements to Meson version constraints.
+
+    Cargo's comparison requirements map directly to Meson's comparisons.
+    Tilde, wildcard, and caret requirements are expanded into an inclusive
+    lower bound and an exclusive upper bound.
+    """
+    result: T.List[str] = []
+    for raw_requirement in cargo_ver.split(','):
+        requirement = raw_requirement.strip()
+        if not requirement:
+            continue
+
+        # Comparison requirements do not imply an additional compatibility
+        # range. Meson accepts Cargo's comparison spelling directly; retain it
+        # after trimming whitespace around the comma-separated requirement.
+        if requirement.startswith(('>=', '<=', '>', '<', '=')):
+            result.append(requirement)
+            continue
+
+        if requirement.startswith('~'):
+            lower = requirement[1:].strip()
+            components = _release_components(lower)
+            # ~1 is <2, while ~1.2 and ~1.2.3 are both <1.3.
+            upper_index = 0 if len(components) == 1 else 1
+            result.extend(_range(lower, _upper_bound(components, upper_index)))
+            continue
+
+        wildcard_parts = requirement.split('.')
+        wildcard_at = next((i for i, p in enumerate(wildcard_parts)
+                            if p.lower() in {'*', 'x'}), None)
+        if wildcard_at is not None:
+            # A bare wildcard imposes no version constraint.
+            if wildcard_at == 0:
+                continue
+            prefix = wildcard_parts[:wildcard_at]
+            components = [int(component) for component in prefix]
+            lower = '.'.join(prefix)
+            result.extend(_range(lower, _upper_bound(components, len(components) - 1)))
+            continue
+
+        # A requirement without an operator is a caret requirement.
+        lower = requirement[1:].strip() if requirement.startswith('^') else requirement
+        components = _release_components(lower)
+        upper_index = next((i for i, component in enumerate(components) if component != 0),
+                           len(components) - 1)
+        result.extend(_range(lower, _upper_bound(components, upper_index)))
+
+    return result
