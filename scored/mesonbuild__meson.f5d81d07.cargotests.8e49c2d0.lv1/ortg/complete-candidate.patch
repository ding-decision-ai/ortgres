@@ -31,3 +31,29 @@ class TomlImplementationMissing(MesonException):
     pass
 
 
+def load_toml(filename: str) -> T.Dict[str, object]:
+    """Load a TOML document using the first available implementation."""
+    if tomllib is not None:
+        with open(filename, 'rb') as f:
+            return T.cast('T.Dict[str, object]', tomllib.load(f))
+
+    if toml2json is None:
+        raise TomlImplementationMissing('No TOML implementation is available')
+
+    # Validate access here so FileNotFoundError and PermissionError have the
+    # same behaviour as the in-process parser backend.
+    with open(filename, 'rb'):
+        pass
+
+    process, stdout, stderr = Popen_safe([toml2json, filename])
+    if process.returncode != 0:
+        detail = stderr.strip() or stdout.strip()
+        raise MesonException(f'Failed to decode TOML file {filename!r}: {detail}')
+    try:
+        value = json.loads(stdout)
+    except json.JSONDecodeError as e:
+        raise MesonException(f'Failed to decode TOML file {filename!r}: {e}') from e
+    if not isinstance(value, dict):
+        raise MesonException(f'Failed to decode TOML file {filename!r}: expected a table')
+    return T.cast('T.Dict[str, object]', value)
+
diff --git a/mesonbuild/cargo/version.py b/mesonbuild/cargo/version.py
index 1f8127b..9a71c71 100644
--- a/mesonbuild/cargo/version.py
+++ b/mesonbuild/cargo/version.py
@@ -7,3 +7,80 @@ from __future__ import annotations
 import typing as T
 
 
+def api(version: str) -> str:
+    """Return the Cargo API compatibility component of a version."""
+    components = version.split('.')
+    major = int(components[0])
+    if major:
+        return str(major)
+    if len(components) > 1:
+        minor = int(components[1])
+        if minor:
+            return f'0.{minor}'
+    return '0'
+
+
+def _incremented_upper_bound(version: str, position: int) -> str:
+    """Increment one numeric component and clear all components after it."""
+    components = version.split('.')
+    numeric = [int(component) for component in components]
+    numeric[position] += 1
+    numeric[position + 1:] = [0] * (len(numeric) - position - 1)
+    return '.'.join(str(component) for component in numeric)
+
+
+def _caret(version: str) -> T.List[str]:
+    components = version.split('.')
+    numeric = [int(component) for component in components]
+    position = next((i for i, component in enumerate(numeric) if component), len(numeric) - 1)
+    upper = _incremented_upper_bound(version, position)
+    return [f'>= {version}', f'< {upper}']
+
+
+def _tilde(version: str) -> T.List[str]:
+    components = version.split('.')
+    position = 0 if len(components) == 1 else len(components) - 2
+    upper = _incremented_upper_bound(version, position)
+    return [f'>= {version}', f'< {upper}']
+
+
+def _wildcard(version: str) -> T.List[str]:
+    components = version.split('.')
+    wildcard = next(i for i, component in enumerate(components)
+                    if component.lower() in {'*', 'x'})
+    if wildcard == 0:
+        return []
+
+    # Cargo treats unspecified wildcard components as zero for the lower
+    # bound, and increments the component immediately before the wildcard for
+    # the exclusive upper bound.
+    lower_components = components[:wildcard] + ['0'] * (len(components) - wildcard)
+    lower = '.'.join(lower_components)
+    upper = _incremented_upper_bound(lower, wildcard - 1)
+    return [f'>= {lower}', f'< {upper}']
+
+
+def convert(cargo_ver: str) -> T.List[str]:
+    """Convert a Cargo version requirement to Meson comparison strings."""
+    result: T.List[str] = []
+    for requirement in cargo_ver.split(','):
+        requirement = requirement.strip()
+        if not requirement:
+            continue
+
+        if requirement.startswith(('>=', '<=')):
+            result.append(f'{requirement[:2]} {requirement[2:].strip()}')
+        elif requirement.startswith(('>', '<')):
+            result.append(f'{requirement[0]} {requirement[1:].strip()}')
+        elif requirement.startswith('='):
+            result.append(f'== {requirement[1:].strip()}')
+        elif requirement.startswith('~'):
+            result.extend(_tilde(requirement[1:].strip()))
+        else:
+            version = requirement[1:].strip() if requirement.startswith('^') else requirement
+            if any(component.lower() in {'*', 'x'} for component in version.split('.')):
+                result.extend(_wildcard(version))
+            else:
+                result.extend(_caret(version))
+    return result
+
