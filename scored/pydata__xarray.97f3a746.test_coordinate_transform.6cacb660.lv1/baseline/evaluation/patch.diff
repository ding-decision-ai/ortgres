+def get_array_namespace(*values):
+    """Return a common array namespace, defaulting to NumPy."""
+    flattened = values
+    if len(values) == 1 and isinstance(values[0], (list, tuple)):
+        flattened = tuple(values[0])
+    namespaces = []
+    for value in flattened:
+        # Dtypes, scalar classes and Python scalars do not select an array
+        # namespace. NumPy scalar classes expose an unbound namespace method.
+        if isinstance(value, type | np.dtype | np.ndarray) or np.isscalar(value):
+            continue
+        if isinstance(value, array_type("dask")):
+            import dask.array as da
+
+            namespaces.append(da)
+            continue
+        namespace = getattr(value, "__array_namespace__", None)
+        if namespace is not None:
+            namespaces.append(namespace())
+        # NumPy arrays can be consumed by the other supported namespaces, so
+        # they deliberately do not select NumPy here.
+    if not namespaces:
+        return np
+    first = namespaces[0]
+    if any(namespace is not first for namespace in namespaces[1:]):
+        raise TypeError("Mixed array types are not supported")
+    return first
+
