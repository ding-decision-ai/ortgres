+def _extract_score_and_justification(text):
+    if not text:
+        return None, None
+
+    failure = f"Failed to extract score and justification from model output: {text}"
+    try:
+        response = json.loads(text)
+    except json.JSONDecodeError:
+        match = re.search(
+            r"score:\s*(\d+)\s*,?\s*justification:\s*(.+)",
+            text,
+            flags=re.IGNORECASE | re.DOTALL,
+        )
+        if match is None:
+            return None, failure
+        return int(match.group(1)), match.group(2).strip()
+
+    response = {key.lower(): value for key, value in response.items()}
+    score = int(response["score"])
+    justification = response["justification"]
+    if not isinstance(justification, str):
+        return None, failure
+    return score, justification
+
+
+def _format_args_string(grading_context_columns: list[str] | None, eval_values, indx) -> str:
+    formatted = []
+    for column in grading_context_columns:
+        if column not in eval_values:
+            raise MlflowException(
+                f"Missing grading context column '{column}'. Available columns: "
+                f"{list(eval_values.keys())}",
+                error_code=INVALID_PARAMETER_VALUE,
+            )
+        values = eval_values[column]
+        value = values.iloc[indx] if isinstance(values, pd.Series) else values[indx]
+        formatted.append(f"key: {column}\nvalue:\n{value}")
+
+    if not formatted:
+        return ""
+    return "Additional information used by the model:\n" + "\n".join(formatted)
+
+
 
 
 
