@@ -29,3 +29,49 @@ class PromptTemplate:
     def __init__(self, template_str: str | list[str]):
         self.template_strs = [template_str] if isinstance(template_str, str) else template_str
 
+    @staticmethod
+    def _field_root(field_name: str) -> str:
+        """Return the keyword portion of a possibly compound format field."""
+        return field_name.split(".", 1)[0].split("[", 1)[0]
+
+    def format(self, **kwargs: Any) -> str:
+        values = {key: value for key, value in kwargs.items() if value is not None}
+        formatter = string.Formatter()
+        rendered = []
+
+        for template in self.template_strs:
+            fields = [
+                self._field_root(field_name)
+                for _, field_name, _, _ in formatter.parse(template)
+                if field_name is not None
+            ]
+            if all(field in values for field in fields):
+                rendered.append(template.format(**values))
+
+        return "".join(rendered)
+
+    def partial_fill(self, **kwargs: Any) -> "PromptTemplate":
+        values = {key: value for key, value in kwargs.items() if value is not None}
+        formatter = string.Formatter()
+        partially_filled = []
+
+        for template in self.template_strs:
+            parts = []
+            for literal, field_name, format_spec, conversion in formatter.parse(template):
+                parts.append(literal)
+                if field_name is None:
+                    continue
+
+                if self._field_root(field_name) in values:
+                    value, _ = formatter.get_field(field_name, (), values)
+                    if conversion:
+                        value = formatter.convert_field(value, conversion)
+                    parts.append(formatter.format_field(value, format_spec))
+                else:
+                    conversion_text = f"!{conversion}" if conversion else ""
+                    format_text = f":{format_spec}" if format_spec else ""
+                    parts.append(f"{{{field_name}{conversion_text}{format_text}}}")
+
+            partially_filled.append("".join(parts))
+
+        return PromptTemplate(partially_filled)
