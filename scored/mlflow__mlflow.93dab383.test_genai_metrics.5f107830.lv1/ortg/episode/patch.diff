@@ -1,3 +1,12 @@
 import importlib
 
 
+def _get_class_from_string(fully_qualified_class_name: str):
+    module_name, separator, class_name = fully_qualified_class_name.rpartition(".")
+    if not separator:
+        raise ValueError(
+            f"Class name must be fully qualified: {fully_qualified_class_name!r}"
+        )
+    module = importlib.import_module(module_name)
+    return getattr(module, class_name)
