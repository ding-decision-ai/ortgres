+            raise MlflowException(
+                f"Missing grading context column '{column}'. Available columns: "
+                f"{list(eval_values.keys())}",
+                error_code=INVALID_PARAMETER_VALUE,
+            )
+        values = eval_values[column]
+        value = values.iloc[indx] if isinstance(values, pd.Series) else values[indx]
+        formatted.append(f"key: {column}\nvalue:\n{value}")
+
+    if not formatted:
+        return ""
+    return "Additional information used by the model:\n" + "\n".join(formatted)
+
