@@ -29,3 +29,31 @@ class PromptTemplate:
     def __init__(self, template_str: str | list[str]):
         self.template_strs = [template_str] if isinstance(template_str, str) else template_str
 
+    @staticmethod
+    def _variables(template_str: str) -> set[str]:
+        """Return the top-level replacement fields used by *template_str*."""
+        variables = set()
+        for _, field_name, _, _ in string.Formatter().parse(template_str):
+            if field_name is not None:
+                # ``str.format`` accepts attribute and item access.  Availability is
+                # determined by the first component in either case.
+                variables.add(field_name.split(".", 1)[0].split("[", 1)[0])
+        return variables
+
+    def format(self, **kwargs: Any) -> str:
+        values = {key: value for key, value in kwargs.items() if value is not None}
+        return "".join(
+            template_str.format(**values)
+            for template_str in self.template_strs
+            if self._variables(template_str).issubset(values)
+        )
+
+    def partial_fill(self, **kwargs: Any) -> "PromptTemplate":
+        """Fill the supplied fields while leaving all other fields untouched."""
+
+        class _Unfilled(dict):
+            def __missing__(self, key):
+                return "{" + key + "}"
+
+        values = {key: value for key, value in kwargs.items() if value is not None}
+        return PromptTemplate([template.format_map(_Unfilled(values)) for template in self.template_strs])
