 # This is also useful to distinguish between the metric signatures with different eval_fn signatures
 
 
+def _generate_eval_metric_class(eval_fn, require_strict_signature=False):
+    eval_signature = inspect.signature(eval_fn)
+
+    class CallableEvaluationMetric(EvaluationMetric):
+        def __call__(self, **kwargs):
+            if not require_strict_signature:
+                return self.eval_fn(**kwargs)
+
+            declared = {
+                name: parameter
+                for name, parameter in eval_signature.parameters.items()
+                if parameter.kind
+                not in (inspect.Parameter.VAR_POSITIONAL, inspect.Parameter.VAR_KEYWORD)
+            }
+            unexpected = set(kwargs) - set(declared)
+            if unexpected:
+                raise MlflowException(
+                    f"Unexpected keyword arguments: {sorted(unexpected)}",
+                    error_code=INVALID_PARAMETER_VALUE,
+                )
+
+            missing = {
+                name
+                for name, parameter in declared.items()
+                if name not in kwargs
+                and name not in {"predictions", "metrics", "inputs"}
+                and parameter.default is inspect.Parameter.empty
+            }
+            if missing:
+                raise MlflowException(
+                    f"Missing required arguments: {sorted(missing)}",
+                    error_code=INVALID_PARAMETER_VALUE,
+                )
+
+            call_args = {}
+            for name, parameter in declared.items():
+                if name in kwargs:
+                    value = kwargs[name]
+                elif name in {"predictions", "metrics", "inputs"}:
+                    value = None
+                elif parameter.default is not inspect.Parameter.empty:
+                    value = parameter.default
+                else:  # guarded by the missing-argument check above
+                    continue
+
+                if name == "metrics":
+                    call_args[name] = value or {}
+                    continue
+
+                if value is not None and not isinstance(value, (pd.Series, str, list)):
+                    raise TypeError(
+                        f"Expected argument '{name}' to be a pandas Series, string, list, "
+                        f"or None, but got {type(value).__name__}."
+                    )
+                if isinstance(value, (str, list)):
+                    value = pd.Series([value] if isinstance(value, str) else value)
+                call_args[name] = value
+
+            return self.eval_fn(**call_args)
+
+    # Give the callable a useful keyword-only signature without manufacturing source
+    # code. ``self`` is retained here because inspect removes it for bound methods.
+    displayed_parameters = [
+        Parameter("self", kind=Parameter.POSITIONAL_OR_KEYWORD),
+        *[
+            parameter.replace(
+                kind=Parameter.KEYWORD_ONLY,
+                default=(
+                    None
+                    if require_strict_signature
+                    and parameter.name in {"predictions", "metrics", "inputs"}
+                    else parameter.default
+                ),
+            )
+            for parameter in eval_signature.parameters.values()
+            if parameter.kind
+            not in (inspect.Parameter.VAR_POSITIONAL, inspect.Parameter.VAR_KEYWORD)
+        ],
+    ]
+    CallableEvaluationMetric.__call__.__signature__ = Signature(
+        displayed_parameters,
+        return_annotation=eval_signature.return_annotation,
+    )
+    return CallableEvaluationMetric
+
+
+def make_metric(
+    *,
+    eval_fn,
+    greater_is_better,
+    name=None,
+    long_name=None,
+    version=None,
+    metric_details=None,
+    metric_metadata=None,
+):
+    if name is None:
+        if not hasattr(eval_fn, "__name__"):
+            raise MlflowException(
+                "`name` must be specified if `eval_fn` does not have a `__name__` attribute.",
+                error_code=INVALID_PARAMETER_VALUE,
+            )
+        if eval_fn.__name__ == "<lambda>":
+            raise MlflowException(
+                "`name` must be specified if `eval_fn` is a lambda function.",
+                error_code=INVALID_PARAMETER_VALUE,
+            )
+        name = eval_fn.__name__
+
+    if "/" in name:
+        raise MlflowException(
+            f"Invalid metric name '{name}'. Metric names cannot include forward slashes ('/').",
+            error_code=INVALID_PARAMETER_VALUE,
+        )
+    if keyword.iskeyword(name):
