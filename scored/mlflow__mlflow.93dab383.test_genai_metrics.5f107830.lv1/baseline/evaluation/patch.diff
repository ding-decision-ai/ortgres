+def _extraction_failure(text):
+    return None, f"Failed to extract score and justification. Raw output: {text}"
+
+
+def _extract_score_and_justification(text):
+    if not text:
+        return None, None
+
+    try:
+        response = json.loads(text)
+    except json.JSONDecodeError:
+        match = re.search(
+            r"score\s*:\s*(\d+)\s*,?\s*justification\s*:\s*(.*)",
+            text,
+            flags=re.IGNORECASE | re.DOTALL,
+        )
+        if match is None:
+            return _extraction_failure(text)
+        score = int(match.group(1))
+        justification = match.group(2).strip()
+    else:
+        # Deliberately do not catch errors after valid JSON has been decoded. A
+        # syntactically valid but structurally invalid judge response is a model
+        # contract error, rather than an alternative plain-text response.
+        response = {key.lower(): value for key, value in response.items()}
+        score = int(response["score"])
+        justification = response["justification"]
+
+    if not isinstance(justification, str):
+        return _extraction_failure(text)
+    return score, justification
+
