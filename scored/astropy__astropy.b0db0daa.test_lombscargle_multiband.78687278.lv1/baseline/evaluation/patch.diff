+def quantity_day_frac(val1, val2=None):
+    """Return time quantities in days as pairs of float64 values.
+
+    For units whose conversion to days is a simple scaling, the scaling is
+    incorporated into :func:`day_frac` so that the conversion does not lose
+    the low-order part of the value.  More general unit conversions fall back
+    to the normal quantity conversion machinery.
+    """
+
+    def to_day_pair(value):
+        try:
+            scale = value.unit._to(u.day)
+        except u.UnitsError:
+            # A conversion through an equivalency (or another non-scaling
+            # conversion) cannot be split into exact floating-point
+            # operations.  Keep its result in the first component.
+            day = value.to_value(u.day)
+            return day, np.zeros_like(day)
+
+        # Prefer division for units smaller than a day.  In particular, this
+        # turns seconds into division by the exactly representable 86400,
+        # instead of multiplication by its inexact reciprocal.
+        if abs(scale) < 1.0:
+            return day_frac(value.value, 0.0, divisor=1.0 / scale)
+        else:
+            return day_frac(value.value, 0.0, factor=scale)
+
+    day, frac = to_day_pair(val1)
+    if val2 is not None:
+        day2, frac2 = to_day_pair(val2)
+        day = day + day2
+        frac = frac + frac2
+
+    return day, frac
 
 
