+        parsed = urllib.parse.urlsplit(uri)
+        # Accessing these properties performs validation that urlsplit itself
+        # defers, notably for malformed IPv6 literals and invalid ports.
+        parsed.hostname
+        parsed.port
+    except (TypeError, ValueError):
+        return False
+    return True
+
