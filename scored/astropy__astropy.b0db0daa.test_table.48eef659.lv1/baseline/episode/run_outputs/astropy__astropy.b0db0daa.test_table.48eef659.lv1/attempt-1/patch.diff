@@ -432,6 +432,60 @@ def _as_quantities(*args):
         raise NotImplementedError
 
 
+def _as_quantity(a):
+    """Convert a single argument to a Quantity."""
+    return _as_quantities(a)[0]
+
+
+def _quantities2arrays(*args, unit_from_first=False):
+    """Convert compatible quantity-like arguments to plain arrays."""
+    from astropy.units import Quantity
+
+    quantities = _as_quantities(*args)
+    if not quantities:
+        return (), dimensionless_unscaled
+
+    if unit_from_first:
+        reference = quantities[0]
+    else:
+        # Plain arrays are interpreted as dimensionless, but should not force
+        # the result to be dimensionless if a later argument supplies a unit.
+        first_has_unit = isinstance(args[0], Quantity) or getattr(
+            args[0], "unit", None
+        ) is not None
+        reference = (
+            quantities[0]
+            if first_has_unit
+            else next(
+                (
+                    q
+                    for q in quantities[1:]
+                    if not q.unit.is_equivalent(dimensionless_unscaled)
+                ),
+                quantities[0],
+            )
+        )
+
+    # Use the original arguments here.  ``_to_own_unit`` deliberately accepts
+    # bare zero/inf/nan values for any unit, while wrapping them in a
+    # dimensionless Quantity first would lose that behavior.
+    arrays = tuple(
+        q.to_value(reference.unit)
+        if isinstance(arg, Quantity) or getattr(arg, "unit", None) is not None
+        else reference._to_own_unit(arg)
+        for arg, q in zip(args, quantities)
+    )
+    return arrays, reference.unit
+
+
+def _iterable_helper(*args, out=None, **kwargs):
+    """Convert arguments to compatible arrays and handle a Quantity output."""
+    arrays, unit = _quantities2arrays(*args)
+    if out is not None:
+        kwargs["out"] = _quantity_out_as_array(out)
+    return arrays, kwargs, unit, out
+
+
 
 
 
