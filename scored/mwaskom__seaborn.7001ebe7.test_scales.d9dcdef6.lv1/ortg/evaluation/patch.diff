+        "g": "gamma",
+        "h": "hue",
+        "l": "light",
+        "d": "dark",
+    }
+    for item in argstr.split(","):
+        item = item.strip()
+        if not item:
+            continue
+        if "=" in item:
+            key, value = (part.strip() for part in item.split("=", 1))
