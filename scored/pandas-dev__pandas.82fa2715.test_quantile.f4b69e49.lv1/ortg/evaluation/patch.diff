+def get_group_index(
+    labels: list[np.ndarray],
+    shape: Shape,
+    sort: bool,
+    xnull: bool,
+) -> npt.NDArray[np.int64]:
+    """Encode a sequence of label arrays into a single int64 group id."""
+
+    def int64_cut_off(level_shape: list[int]) -> int:
+        acc = 1
+        for i, size in enumerate(level_shape):
+            acc *= int(size)
+            if acc >= lib.i8max:
+                return i
+        return len(level_shape)
+
+    def maybe_lift(lab: np.ndarray, size: int) -> tuple[np.ndarray, int]:
+        if (lab == -1).any():
+            return lab + 1, size + 1
+        return lab, size
+
+    labels = [ensure_int64(label) for label in labels]
+    level_shape = [int(size) for size in shape]
+    if not xnull:
+        for i, (label, size) in enumerate(zip(labels, level_shape, strict=True)):
+            labels[i], level_shape[i] = maybe_lift(label, size)
+
+    while True:
+        nlev = int64_cut_off(level_shape)
+        stride = np.prod(level_shape[1:nlev], dtype="i8")
+        out = stride * labels[0].astype("i8", subok=False, copy=False)
+
+        for i in range(1, nlev):
+            if level_shape[i] == 0:
+                stride = np.int64(0)
+            else:
+                stride //= level_shape[i]
+            out += labels[i] * stride
+
+        if xnull:
+            mask = labels[0] == -1
+            for label in labels[1:nlev]:
+                mask |= label == -1
+            out[mask] = -1
+
+        if nlev == len(level_shape):
+            break
+
+        comp_ids, obs_ids = compress_group_index(out, sort=sort)
+        labels = [comp_ids, *labels[nlev:]]
+        level_shape = [len(obs_ids), *level_shape[nlev:]]
+
+    return ensure_int64(out)
+
+
+def is_int64_overflow_possible(shape: Shape) -> bool:
+    the_prod = 1
+    for size in shape:
+        the_prod *= int(size)
