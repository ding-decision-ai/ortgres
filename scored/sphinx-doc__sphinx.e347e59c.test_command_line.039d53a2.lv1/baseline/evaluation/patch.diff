+def run_make_mode(args: Sequence[str]) -> int:
+    """Run ``sphinx-build`` in make mode."""
+    if len(args) < 3:
+        print('Error: at least three arguments required.')
+        return 1
+
+    builder, srcdir, builddir = args[:3]
+    make = Make(srcdir, builddir, args[3:])
+    run_method = getattr(make, f'build_{builder}', None)
+    if run_method is not None:
+        return run_method()
+    return make.run_generic_build(builder)
