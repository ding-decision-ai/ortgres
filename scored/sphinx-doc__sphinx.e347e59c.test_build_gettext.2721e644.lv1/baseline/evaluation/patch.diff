--- a/sphinx/builders/gettext.py
+++ b/sphinx/builders/gettext.py
@@ -76,6 +76,15 @@ def __init__(self) -> None:
         # msgid -> file, line, uid
         self.metadata: dict[str, list[tuple[str, int, str]]] = {}
 
+    def add(self, msg: str, origin: Element | MsgOrigin) -> None:
+        if not hasattr(origin, 'uid'):
+            # Replicated nodes, such as todo items, can lack a stable UID.
+            return
+
+        source = origin.source or ''
+        line = origin.line if origin.line is not None else -1
+        self.metadata.setdefault(msg, []).append((source, line, origin.uid))
+
 
 
 
@@ -115,7 +124,28 @@ def __repr__(self) -> str:
 
 
 class GettextRenderer(SphinxRenderer):
-    pass
+    def __init__(
+        self,
+        template_path: Sequence[str | os.PathLike[str]] | None = None,
+        outdir: str | os.PathLike[str] | None = None,
+    ) -> None:
+        search_path = list(template_path or ())
+        search_path.append(DEFAULT_TEMPLATE_PATH)
+        super().__init__(search_path)
+
+        self.env.filters['e'] = self.escape
+        self.env.filters['escape'] = self.escape
+        self.outdir = outdir
+
+    def render(self, filename: str, context: dict[str, Any]) -> str:
+        context['relpath'] = lambda source: canon_path(relpath(source, self.outdir))
+        return super().render(filename, context)
+
+    @staticmethod
+    def escape(value: str) -> str:
+        return (
+            value.replace('\\', '\\\\').replace('"', '\\"').replace('\n', '\\n"\n"')
+        )
 
 
 
