+def group_subtrees(
+    *trees: AnyNamedNode,
+) -> Iterator[tuple[str, tuple[AnyNamedNode, ...]]]:
+    """Yield corresponding nodes from isomorphic trees in breadth-first order."""
+    if not trees:
+        raise TypeError("must pass at least one tree object")
+
+    queue: collections.deque[tuple[str, tuple[AnyNamedNode, ...]]] = collections.deque(
+        [(".", trees)]
+    )
+    while queue:
+        path, nodes = queue.popleft()
+
+        # Deliberately yield before checking the children.  Consumers which
+        # stop early should not pay for (or observe) later structure checks.
+        yield path, nodes
+
+        first_keys = list(nodes[0].children)
+        first_key_set = set(first_keys)
+        for node in nodes[1:]:
+            other_keys = list(node.children)
+            if set(other_keys) != first_key_set:
+                location = "root node" if path == "." else f"node {path!r}"
+                raise TreeIsomorphismError(
+                    f"children at {location} do not match: "
+                    f"{first_keys!r} vs {other_keys!r}"
+                )
+
+        # Child order is defined solely by the first tree.  Indexing by name
+        # keeps corresponding nodes aligned when insertion order differs.
+        for name in first_keys:
+            child_path = name if path == "." else f"{path}/{name}"
+            queue.append((child_path, tuple(node.children[name] for node in nodes)))
+
+
+def zip_subtrees(*trees: AnyNamedNode) -> Iterator[tuple[AnyNamedNode, ...]]:
+    """Yield corresponding nodes of isomorphic trees in breadth-first order."""
+    for _, nodes in group_subtrees(*trees):
+        yield nodes
