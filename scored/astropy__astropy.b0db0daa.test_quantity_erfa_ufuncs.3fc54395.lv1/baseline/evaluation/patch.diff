index 5c5eff3..690749a 100644
--- a/astropy/units/structured.py
+++ b/astropy/units/structured.py
@@ -11,6 +11,8 @@ from typing import Self
 
 import numpy as np
 
+from astropy.utils.compat import COPY_IF_NEEDED
+
 from .core import UNITY, Unit, UnitBase
 
 __all__ = ["StructuredUnit"]
@@ -31,6 +33,33 @@ def _names_from_dtype(dtype):
     return tuple(names)
 
 
+def _normalize_names(names):
+    """Normalize possibly nested field names for a structured unit."""
+    normalized = []
+    for name in names:
+        if isinstance(name, str) and name:
+            normalized.append(name)
+        elif isinstance(name, tuple) and name:
+            subnames = _normalize_names(name)
+            combined = "".join(
+                subname[0] if isinstance(subname, list) else subname
+                for subname in subnames
+            )
+            normalized.append([combined, subnames])
+        elif (
+            isinstance(name, list)
+            and len(name) == 2
+            and isinstance(name[0], str)
+            and name[0]
+            and isinstance(name[1], tuple)
+            and name[1]
+        ):
+            normalized.append([name[0], _normalize_names(name[1])])
+        else:
+            raise ValueError(f"invalid entry {name!r} in names.")
+    return tuple(normalized)
+
+
 
 
 
@@ -446,6 +475,54 @@ class StructuredUnit:
     __array_ufunc__ = None
 
 
+    def __rlshift__(self, m):
+        """Create a structured Quantity from ``m << self``."""
+        try:
+            from .quantity import Quantity
+
+            return Quantity(m, self, copy=COPY_IF_NEEDED, subok=True)
+        except Exception:
+            if isinstance(m, np.ndarray):
+                raise
+            return NotImplemented
+
+    def __mul__(self, other):
+        if isinstance(other, str):
+            try:
+                other = Unit(other, parse_strict="silent")
+            except Exception:
+                return NotImplemented
+
+        if isinstance(other, UnitBase):
+            new_units = tuple(part * other for part in self.values())
+            return self.__class__(new_units, names=self)
+
+        try:
+            from .quantity import Quantity
+
+            return Quantity(other, unit=self)
+        except TypeError:
+            if isinstance(other, np.ndarray):
+                raise
+            return NotImplemented
+
+    def __rmul__(self, other):
+        """Multiply a unit by this unit, or attach this unit to a value."""
+        if isinstance(other, (str, UnitBase)):
+            return self * other
+
+        try:
+            from .quantity import Quantity
+
+            if hasattr(other, "unit"):
+                return Quantity(other.value, unit=self * other.unit)
+            return Quantity(other, unit=self)
+        except TypeError:
+            if isinstance(other, np.ndarray):
+                raise
+            return NotImplemented
+
+
 
 
 
