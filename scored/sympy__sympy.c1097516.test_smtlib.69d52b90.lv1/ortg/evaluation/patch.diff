+def _decimal_to_Rational_prec(dec):
+    """Convert a finite ``Decimal`` to an exact number and digit count."""
+    if not dec.is_finite():
+        raise TypeError("non-finite Decimal cannot be converted to Rational")
+
+    sign, digits, exponent = dec.as_tuple()
+    coefficient = 0
+    for digit in digits:
+        coefficient = 10*coefficient + digit
+    if sign:
+        coefficient = -coefficient
+
+    if not coefficient:
+        result = Integer(0)
+    elif exponent < 0:
+        result = Rational(coefficient, 10**-exponent)
+    else:
+        result = Integer(coefficient*10**exponent)
+    return result, len(digits)
+
+
+def int_valued(x):
+    """Return whether *x* is a supported literal integer representation."""
+    if isinstance(x, (SYMPY_INTS, Integer)):
+        return True
+    if type(x) is float:
+        return x.is_integer()
+    if isinstance(x, Float):
+        return x._mpf_[2] >= 0
+    return False
+
