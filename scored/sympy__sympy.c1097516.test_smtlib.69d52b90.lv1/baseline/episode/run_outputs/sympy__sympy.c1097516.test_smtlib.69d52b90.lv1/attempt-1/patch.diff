+def int_valued(x):
+    """Return whether *x* is a supported literal integer representation."""
+    if isinstance(x, (SYMPY_INTS, Integer)):
+        return True
+    if type(x) is float:
+        return float.is_integer(x)
+    if isinstance(x, Float):
+        _, man, exponent, bitcount = x._mpf_
+        return (man == 0 and bitcount == 0) or (man != 0 and exponent >= 0)
+    return False
+
