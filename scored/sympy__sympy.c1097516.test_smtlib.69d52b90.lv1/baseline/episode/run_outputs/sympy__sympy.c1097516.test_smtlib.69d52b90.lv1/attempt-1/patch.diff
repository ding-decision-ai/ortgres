+def _decimal_to_Rational_prec(dec):
+    """Convert a finite ``Decimal`` to an exact number and digit count."""
+    if not dec.is_finite():
+        raise TypeError("non-finite Decimal cannot be converted to Rational")
+
+    sign, digits, exponent = dec.as_tuple()
+    coefficient = 0
+    for digit in digits:
+        coefficient = coefficient * 10 + digit
+    if sign:
+        coefficient = -coefficient
+
+    if exponent >= 0:
+        number = Integer(coefficient*10**exponent)
+    else:
+        number = Rational(coefficient, 10**-exponent)
+    return number, len(digits)
+
+
 
 
 
