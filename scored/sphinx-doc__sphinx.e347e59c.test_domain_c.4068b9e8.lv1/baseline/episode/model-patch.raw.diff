+                    [ASTIdentifier(self.matched_text)], rooted=False
+                )
+                self.skip_ws()
+                variadic = self.skip_string('...')
+                args.append(ASTMacroParameter(arg, variadic=variadic))
+            elif self.skip_string(')'):
+                break
+            else:
+                self.fail("Expected identifier, ')', or ',' in macro parameter list.")
+
+            self.skip_ws()
+            if self.skip_string(','):
+                continue
