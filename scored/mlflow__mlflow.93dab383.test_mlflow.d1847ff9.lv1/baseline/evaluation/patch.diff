+def resolve_request_headers(request_headers=None):
+    """Resolve and merge headers from all providers active in this context."""
+    headers = {}
+    for provider in _request_header_provider_registry:
+        try:
+            if not provider.in_context():
+                continue
+            provider_headers = provider.request_headers()
+        except Exception as e:
+            _logger.warning(
+                "Encountered an unexpected error while resolving request headers: %s", e
+            )
+            continue
+        for name, value in provider_headers.items():
+            headers[name] = f"{headers[name]} {value}" if name in headers else value
+    if request_headers:
+        headers.update(request_headers)
+    return headers
