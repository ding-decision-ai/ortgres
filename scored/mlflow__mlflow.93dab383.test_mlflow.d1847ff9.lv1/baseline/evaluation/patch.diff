+def _get_http_response_with_retries(
+    method,
+    url,
+    max_retries,
+    backoff_factor,
+    backoff_jitter,
+    retry_codes,
+    raise_on_status=True,
+    timeout=None,
+    respect_retry_after_header=True,
+    **kwargs,
+):
+    """Issue a request using a cached session configured with urllib3 retries."""
+    retry_codes = tuple(sorted(retry_codes))
+    session = _cached_get_request_session(
+        max_retries,
+        backoff_factor,
+        backoff_jitter,
+        retry_codes,
+        raise_on_status,
+        respect_retry_after_header,
+    )
+    if "allow_redirects" not in kwargs:
+        allow_redirects = os.getenv("MLFLOW_ALLOW_HTTP_REDIRECTS", "true").lower()
+        kwargs["allow_redirects"] = allow_redirects in {"1", "true"}
+    return session.request(method, url, timeout=timeout, **kwargs)
+
