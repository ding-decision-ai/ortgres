+            target_uri = get_deployments_target()
+        except MlflowException:
+            _logger.info(
+                "No deployments target has been set. Set one with "
+                "mlflow.deployments.set_deployments_target() or the "
+                "MLFLOW_DEPLOYMENTS_TARGET environment variable."
+            )
+            return None
+
+    plugin = plugin_store[target_uri]
+    for _, candidate in inspect.getmembers(plugin, inspect.isclass):
+        if candidate is not BaseDeploymentClient and issubclass(candidate, BaseDeploymentClient):
+            return candidate(target_uri)
+
+    # DeploymentPlugins validates this invariant, so this is defensive only.
+    raise MlflowException(f"No deployment client implementation found for target {target_uri!r}")
+
