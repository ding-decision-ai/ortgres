+@lru_cache(maxsize=64)
+def _get_requests_session(
+    max_retries,
+    backoff_factor,
+    backoff_jitter,
+    retry_codes,
+    raise_on_status,
+    respect_retry_after_header,
+):
+    retry_class = Retry if Version(urllib3.__version__) >= Version("2.0.0") else JitteredRetry
+    retry = retry_class(
+        total=max_retries,
+        connect=max_retries,
+        read=max_retries,
+        redirect=max_retries,
+        status=max_retries,
+        status_forcelist=retry_codes,
+        backoff_factor=backoff_factor,
+        backoff_jitter=backoff_jitter,
+        raise_on_status=raise_on_status,
+        respect_retry_after_header=respect_retry_after_header,
+    )
+    session = requests.Session()
+    adapter = HTTPAdapter(max_retries=retry)
+    session.mount("http://", adapter)
+    session.mount("https://", adapter)
+    return session
+
+
+def _get_http_response_with_retries(
+    method,
+    url,
+    max_retries,
+    backoff_factor,
+    backoff_jitter,
+    retry_codes,
+    raise_on_status=True,
+    timeout=None,
+    respect_retry_after_header=True,
+    **kwargs,
+):
+    """Issue an HTTP request using a cached session configured for urllib3 retries."""
+    session = _get_requests_session(
+        max_retries,
+        backoff_factor,
+        backoff_jitter,
+        tuple(retry_codes),
+        raise_on_status,
+        respect_retry_after_header,
+    )
+
+    if "allow_redirects" not in kwargs:
+        env_value = os.getenv("MLFLOW_ALLOW_HTTP_REDIRECTS")
+        kwargs["allow_redirects"] = (
+            True if env_value is None else env_value.lower() in {"1", "true"}
+        )
+
+    return session.request(method, url, timeout=timeout, **kwargs)
+
+
 
 
 
