+def resolve_request_headers(request_headers=None):
+    """Resolve and merge headers from all request-header providers in the active context."""
+    headers = {}
+    for provider in _request_header_provider_registry:
+        try:
+            if not provider.in_context():
+                continue
+            for name, value in provider.request_headers().items():
+                headers[name] = f"{headers[name]} {value}" if name in headers else value
+        except Exception as exc:
+            _logger.warning(
+                "Encountered an unexpected error while resolving request headers from %s: %s",
+                provider.__class__.__name__,
+                exc,
+            )
+
+    if request_headers:
+        headers.update(request_headers)
+    return headers
