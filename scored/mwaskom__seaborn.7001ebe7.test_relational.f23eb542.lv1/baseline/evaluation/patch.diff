+def unique_dashes(n):
+    """Build an arbitrarily long list of unique dash styles for lines."""
+    # Start with dash specs that are particularly easy to distinguish.
+    dashes = [
+        "",
+        (4, 1.5),
+        (1, 1),
+        (3, 1.25, 1.5, 1.25),
+        (5, 1, 1, 1),
+    ]
+
+    # Extend the list deterministically with increasingly complex patterns.
+    p = 3
+    while len(dashes) < n:
+        a = itertools.product([3, 1.25], repeat=p)
+        b = itertools.product([5, 1], repeat=p)
+        for segments in itertools.chain(a, b):
+            gap = min(segments)
+            spec = tuple(itertools.chain.from_iterable(
+                (segment, gap) for segment in segments
+            ))
+            dashes.append(spec)
+        p += 1
+
+    return dashes[:n]
+
+
+def unique_markers(n):
+    """Build an arbitrarily long list of unique marker styles for points."""
+    # Start with filled markers that are particularly easy to distinguish.
+    markers = [
+        "o",
+        "X",
+        (4, 0, 45),
+        "P",
+        (4, 0, 0),
+        (4, 1, 0),
+        "^",
+        (4, 1, 180),
+        "v",
+        (4, 1, 225),
+        (4, 1, 45),
+        "s",
+        (8, 1, 0),
+        (8, 1, 22.5),
+        (8, 1, 45),
+        (8, 1, 67.5),
+    ]
+
+    # Generate increasingly fine-grained regular polygons as needed.
+    seen = set(markers)
+    p = 5
+    while len(markers) < n:
+        angle = 360 / p
+        candidates = [
+            (p, 1, angle / 2),
+            (p, 0, angle / 2),
+            (p, 1, 0),
+            (p, 0, 0),
+        ]
+        for marker in candidates:
+            if marker not in seen:
+                markers.append(marker)
+                seen.add(marker)
+        p += 1
+
+    return markers[:n]
+
+
 
 
 
